@{
    ViewData["Title"] = "Choose Account Type";
}

<div class="registration-gateway">
    <div class="registration-gateway-intro">
        <p class="gateway-kicker"><span></span> IPO Investment Management</p>
        <h1>Choose the account that fits your journey.</h1>
        <p>Start with the workspace built for your goals. You can sign in at any time if you already have an account.</p>
    </div>

    <div class="registration-choice-grid">
        <a class="registration-choice registration-choice-investor" asp-controller="Account" asp-action="RegisterInvestor">
            <span class="choice-number">01</span>
            <span class="choice-icon" aria-hidden="true">↗</span>
            <span class="choice-title">Investor</span>
            <span class="choice-description">Explore IPOs, track opportunities, and manage your investments.</span>
            <span class="choice-link">Register as Investor <span aria-hidden="true">&rarr;</span></span>
        </a>
        <a class="registration-choice registration-choice-company" asp-controller="Account" asp-action="RegisterCompany">
            <span class="choice-number">02</span>
            <span class="choice-icon" aria-hidden="true">+</span>
            <span class="choice-title">Company</span>
            <span class="choice-description">Create your company profile and submit offerings for review.</span>
            <span class="choice-link">Register as Company <span aria-hidden="true">&rarr;</span></span>
        </a>
    </div>

    <p class="registration-gateway-footer">Already registered? <a class="auth-inline-button auth-inline-button-dark" asp-controller="Account" asp-action="Login">Sign in</a></p>
</div>
