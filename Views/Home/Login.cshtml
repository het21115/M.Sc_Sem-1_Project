@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-center mb-2">Welcome back</h1>
                <p class="text-center text-muted mb-4">Sign in to continue to IPO Investment Management.</p>

                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">@successMessage</div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="Email" class="form-label">Email address</label>
                        <input id="Email" name="Email" type="email" class="form-control" autocomplete="email" required />
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">Password</label>
                        <input id="Password" name="Password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>

                    <div class="text-end mb-3">
                        <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn registration-submit auth-submit w-100">Sign in <span aria-hidden="true">&rarr;</span></button>
                </form>

                <p class="text-center mt-4 mb-0">
                    Do not have an account?
                    <a asp-controller="Account" asp-action="Register">Create an account</a>
                </p>
            </div>
        </div>
    </div>
</div>
