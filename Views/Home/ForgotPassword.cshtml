@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-center mb-2">Forgot password?</h1>
                <p class="text-center text-muted mb-4">Enter your account email and we will send you a verification code.</p>

                @if (TempData["ResetMessage"] is string resetMessage)
                {
                    <div class="alert alert-info" role="alert">@resetMessage</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email address</label>
                        <input id="email" name="email" type="email" class="form-control" autocomplete="email" required autofocus />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send verification code</button>
                </form>

                <p class="text-center mt-4 mb-0">
                    <a asp-controller="Account" asp-action="Login">Back to login</a>
                </p>
            </div>
        </div>
    </div>
</div>
