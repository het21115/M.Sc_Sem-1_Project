@model IPOInvestmentManagement.Models.AllotmentHistoryListViewModel
@{
    ViewData["Title"] = "Allotment Result History";
}

<div class="admin-console">
    <header class="admin-topbar">
        <button type="button" class="admin-back-button" data-admin-back="@Url.Action("Applications", "Dashboard")">&#8592; Back</button>
        <div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div>
        <span class="admin-mode">ADMINISTRATOR MODE / ALLOTMENT HISTORY ARCHIVE</span>
        <div class="admin-user">
            <span>@(Context.Session.GetString("UserName") ?? "Admin")</span>
            <i></i>
            <a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a>
        </div>
    </header>

    <main class="admin-main">
        <div class="admin-heading">
            <div>
                <span class="admin-overline">AUDIT ARCHIVE &amp; HISTORICAL SETTLEMENTS</span>
                <h1>IPO Allotment Result History</h1>
                <p>Permanent audit records of all finalized IPO allocations, category shares distribution, fund debits, and mandate releases.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Applications">
                    &#8592; Applications Register
                </a>
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">
                    Dashboard Overview
                </a>
            </div>
        </div>

        @if (TempData["AdminMessage"] is string msg)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- High Level Metrics -->
        <section class="admin-application-stats mb-4">
            <div>
                <span>Finalized IPO Allotments</span>
                <strong>@Model.Items.Count.ToString("N0")</strong>
                <small>Historical events</small>
            </div>
            <div>
                <span>Total Applications Settled</span>
                <strong>@Model.Items.Sum(i => i.TotalApplications).ToString("N0")</strong>
                <small>Full audit trail</small>
            </div>
            <div>
                <span>Total Capital Allocated</span>
                <strong class="text-success">₹@((Model.Items.Sum(i => i.TotalDebitedAmount) / 10000000m).ToString("N2")) Cr</strong>
                <small>@Model.Items.Sum(i => i.TotalAllottedShares).ToString("N0") shares</small>
            </div>
            <div>
                <span>Total Mandates Released</span>
                <strong class="text-warning">₹@((Model.Items.Sum(i => i.TotalUnblockedAmount) / 10000000m).ToString("N2")) Cr</strong>
                <small>Unblocked to investors</small>
            </div>
        </section>

        <!-- Allotment History Records List -->
        <section class="admin-application-panel">
            <div class="admin-section-head mb-3">
                <div>
                    <span class="admin-overline">FINALIZED ALLOTMENT LEDGER</span>
                    <h2>Historical Allotment Records</h2>
                </div>
                <span class="queue-count">@Model.Items.Count record(s)</span>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="admin-empty text-center py-5">
                    <div class="fs-1 text-muted mb-3">&#128196;</div>
                    <h5>No Finalized Allotments Yet</h5>
                    <p class="text-muted">Once automatic or manual allotments are confirmed for an IPO, complete settlement and allotment histories will appear here.</p>
                    <a class="btn btn-primary mt-2" asp-controller="Dashboard" asp-action="Applications">
                        Go to Applications
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-muted text-uppercase">
                                <th>IPO Offering</th>
                                <th>Finalized Date</th>
                                <th>Processed By</th>
                                <th>Applications Breakdown</th>
                                <th>Allotted Shares</th>
                                <th>Debited Amount</th>
                                <th>Unblocked Amount</th>
                                <th>Sub. Multiple</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.IpoName</strong>
                                        <small class="d-block text-muted">@item.CompanyName &middot; Cut-off: ₹@item.CutOffPrice.ToString("N2")</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.FinalizedAt.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@item.FinalizedAt.ToString("hh:mm tt") IST</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.FinalizedByAdminName</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-success" title="Full Allotments">@item.AllottedApplications Full</span>
                                            <span class="badge bg-primary" title="Partial Allotments">@item.PartialAllotmentCount Partial</span>
                                            <span class="badge bg-secondary" title="Non-Allotted">@item.UnallottedCount Unallotted</span>
                                        </div>
                                        <small class="text-muted d-block mt-1">Total: @item.TotalApplications.ToString("N0") applications</small>
                                    </td>
                                    <td>
                                        <strong class="text-success">@item.TotalAllottedShares.ToString("N0")</strong>
                                    </td>
                                    <td>
                                        <strong>₹@item.TotalDebitedAmount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        <strong class="text-warning">₹@item.TotalUnblockedAmount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        <span class="badge @(item.OversubscriptionMultiple > 1.0m ? "bg-danger" : "bg-success")">
                                            @item.OversubscriptionMultiple.ToString("0.00")x
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="AllotmentResults" asp-route-ipoId="@item.IpoId">
                                                &#128065; View Results
                                            </a>
                                            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="AllotmentReport" asp-route-ipoId="@item.IpoId" title="Download CSV register">
                                                &#128196; CSV
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </main>
</div>
