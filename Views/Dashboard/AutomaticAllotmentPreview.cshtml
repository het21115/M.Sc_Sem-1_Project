@model IPOInvestmentManagement.Models.AutomaticAllotmentPreviewViewModel
@{
    ViewData["Title"] = "Automatic Allotment Preview";
}

<div class="admin-console">
    <header class="admin-topbar">
        <button type="button" class="admin-back-button" data-admin-back="@Url.Action("Applications", "Dashboard", new { ipoId = Model.Ipo.IPO_id })">&#8592; Back</button>
        <div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div>
        <span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span>
    </header>
    <main class="admin-main">
        <div class="admin-heading">
            <div>
                <span class="admin-overline">STATUTORY CATEGORY-WISE ALLOTMENT PREVIEW</span>
                <h1>@Model.Ipo.IPO_name</h1>
                <p>SEBI-aligned category-wise allocation: Retail Individual Investors (RII 35%), Non-Institutional Investors (NII/HNI 15%), and Qualified Institutional Buyers (QIB 50%), with automated spillover for under-subscribed quotas, minimum 1-lot guarantee or lottery draw for retail over-subscription, and largest remainder proportional allocation for NII &amp; QIB.</p>
            </div>
        </div>

        <!-- Timing Verification Banner -->
        <div class="p-3 mb-4 rounded-3 border" style="background: linear-gradient(135deg, #f0f7ff, #e6f0fa); border-color: #b9d5ee !important;">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success p-2 fs-6">✓ Timing Verified</span>
                    <div>
                        <strong class="text-navy d-block">Allotment Window Open</strong>
                        <small class="text-muted">
                            Bidding Closed: <strong>@(Model.CloseDate?.ToString("dd MMM yyyy") ?? "N/A")</strong> (Status: <strong>@Model.Ipo.Status</strong>)
                            &middot; Allotment Date: <strong>@(Model.AllotmentDate?.ToString("dd MMM yyyy") ?? "N/A")</strong>
                        </small>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary text-uppercase px-3 py-2">Category-Wise Algorithm Active</span>
                </div>
            </div>
        </div>

        <div class="alert alert-warning mb-4">
            <strong>Review Allotment Calculations:</strong> No allotments or portfolio holdings are persisted until you click &ldquo;Confirm automatic allotment&rdquo; below.
        </div>

        <!-- Issue Overview Stats -->
        <section class="admin-application-panel mt-0 mb-4">
            <div class="admin-section-head mb-3">
                <div>
                    <span class="admin-overline">ISSUE METRICS</span>
                    <h2>Allocation Overview</h2>
                </div>
                <span class="badge bg-light text-dark border p-2">Lot Size: @Model.LotSize.ToString("N0") shares &middot; Price: ₹@Model.AllotmentPrice.ToString("N2")</span>
            </div>
            <div class="admin-application-stats">
                <div>
                    <span>Available Issue Lots</span>
                    <strong>@Model.AvailableLots.ToString("N0")</strong>
                    <small>@Model.AvailableShares.ToString("N0") shares available</small>
                </div>
                <div>
                    <span>Total Demand Received</span>
                    <strong>@Model.TotalAppliedLots.ToString("N0") lots</strong>
                    <small>@Model.TotalAppliedShares.ToString("N0") shares applied (@Model.OverallSubscriptionMultiple.ToString("0.00")x subscription)</small>
                </div>
                <div>
                    <span>Calculated Allotment</span>
                    <strong>@Model.AllocatedLots.ToString("N0") lots</strong>
                    <small>@Model.AllocatedShares.ToString("N0") shares allocated (@(Model.AvailableLots > 0 ? (Model.AllocatedLots * 100 / Model.AvailableLots) : 0)% utilization)</small>
                </div>
            </div>
        </section>

        <!-- Category Breakdown Section -->
        <section class="admin-application-panel mb-4">
            <div class="admin-section-head mb-3">
                <div>
                    <span class="admin-overline">SEBI CATEGORY BREAKDOWN</span>
                    <h2>Category Quotas &amp; Allocation Rules</h2>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Eligibility Criterion</th>
                            <th>Statutory Quota</th>
                            <th>Effective Quota (Post-Spillover)</th>
                            <th>Demand Received</th>
                            <th>Sub. Ratio</th>
                            <th>Applied Allocation Method</th>
                            <th>Final Allocation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.CategorySummaries)
                        {
                            <tr>
                                <td>
                                    <strong>@cat.CategoryName</strong>
                                    <span class="badge @(cat.CategoryCode == "RII" ? "bg-primary" : cat.CategoryCode == "NII" ? "bg-warning text-dark" : "bg-dark") ms-1">
                                        @cat.CategoryCode
                                    </span>
                                </td>
                                <td><small class="text-muted">@cat.MaxApplicationRule</small></td>
                                <td>
                                    <strong>@cat.QuotaPercentage%</strong>
                                    <small class="text-muted d-block">(@cat.InitialQuotaLots.ToString("N0") lots)</small>
                                </td>
                                <td>
                                    <strong>@cat.EffectiveQuotaLots.ToString("N0") lots</strong>
                                    <small class="text-muted d-block">@cat.EffectiveQuotaShares.ToString("N0") shares</small>
                                    @if (!string.IsNullOrWhiteSpace(cat.SpilloverNote) && cat.SpilloverNote != "Standard statutory quota")
                                    {
                                        <small class="text-info d-block mt-1">@cat.SpilloverNote</small>
                                    }
                                </td>
                                <td>
                                    <strong>@cat.AppliedLots.ToString("N0") lots</strong>
                                    <small class="text-muted d-block">(@cat.ApplicationCount applicant(s) &middot; @cat.AppliedShares.ToString("N0") shares)</small>
                                </td>
                                <td>
                                    <span class="badge @(cat.SubscriptionMultiple > 1.0m ? "bg-danger" : "bg-success")">
                                        @cat.SubscriptionMultiple.ToString("0.00")x
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-primary">@cat.AllocationMethod</span>
                                </td>
                                <td>
                                    <strong class="text-success">@cat.AllocatedLots.ToString("N0") lots</strong>
                                    <small class="text-muted d-block">@cat.AllocatedShares.ToString("N0") shares</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Application-by-Application Allotment Register -->
        <section class="admin-application-panel">
            <div class="admin-section-head mb-3">
                <div>
                    <span class="admin-overline">APPLICATION REGISTER</span>
                    <h2>Calculated Allotments for Eligible Applications</h2>
                </div>
                <span class="queue-count">@Model.Rows.Count eligible application(s)</span>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="admin-empty">No submitted applications with verified payment are eligible for allotment.</div>
            }
            else
            {
                <div class="admin-application-list">
                    @foreach (var row in Model.Rows)
                    {
                        <div class="admin-application-row">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <strong>@row.InvestorName</strong>
                                    <span class="badge @(row.CategoryCode == "RII" ? "bg-primary" : row.CategoryCode == "NII" ? "bg-warning text-dark" : "bg-dark")" style="font-size: 0.65rem;">
                                        @row.CategoryCode
                                    </span>
                                </div>
                                <small>
                                    @(row.Application.Application_number ?? $"#{row.Application.Application_id}") &middot;
                                    Applied <strong>@row.Application.Applied_lots.ToString("N0") lot(s)</strong> (@row.Application.Applied_shares.ToString("N0") shares) &middot;
                                    Amount: ₹@row.ApplicationAmount.ToString("N2") &middot;
                                    Category: @row.Category
                                </small>
                            </div>
                            <div class="admin-application-row-meta text-end">
                                <div>
                                    <span class="admin-application-status @(row.Result == "Full allotment" ? "bg-success text-white" : row.Result == "Partial allotment" ? "bg-info text-white" : "bg-secondary text-white")">
                                        @row.Result
                                    </span>
                                </div>
                                <div class="mt-1">
                                    <strong>@row.AllottedLots.ToString("N0") lot(s) / @row.AllottedShares.ToString("N0") shares</strong>
                                    <small class="d-block text-muted">
                                        Allotment Value: ₹@row.AllocatedAmount.ToString("N2")
                                        @if (row.UnblockedAmount > 0)
                                        {
                                            <span class="text-warning">&middot; Refund/Unblock: ₹@row.UnblockedAmount.ToString("N2")</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Final Allotment Confirmation Settlement Card -->
                <div class="card border-0 shadow-sm mt-4 p-4" style="border-radius: 12px; background: linear-gradient(135deg, #f8fafc, #edf2f7); border-left: 5px solid #0d6efd !important;">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                        <div>
                            <span class="badge bg-primary text-uppercase px-2 py-1 mb-1">Final Allotment Confirmation</span>
                            <h3 class="h5 mb-1 text-navy fw-bold">Ready to Confirm &amp; Publish Final Allotment?</h3>
                            <p class="text-muted small mb-0">Review the final accounting totals below. Confirming will permanently record allotments, generate official Allotment Advice (CAN) documents, credit Demat portfolios, dispatch investor email &amp; in-app notifications, and initiate bank mandate unblocking.</p>
                        </div>
                    </div>

                    <div class="row g-3 py-2 border-top border-bottom my-2 small">
                        <div class="col-md-3">
                            <span class="text-muted d-block">Eligible Applications:</span>
                            <strong class="fs-6">@Model.Rows.Count</strong>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted d-block">Allotment Distribution:</span>
                            <span class="badge bg-success">@Model.Rows.Count(r => r.Result == "Full allotment") Full</span>
                            <span class="badge bg-primary">@Model.Rows.Count(r => r.Result == "Partial allotment") Partial</span>
                            <span class="badge bg-secondary">@Model.Rows.Count(r => r.Result == "Not allotted") Unallotted</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted d-block">Capital to Debit:</span>
                            <strong class="fs-6 text-success">₹@Model.Rows.Sum(r => r.AllocatedAmount).ToString("N2")</strong>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted d-block">Mandate Funds to Unblock / Refund:</span>
                            <strong class="fs-6 text-warning">₹@Model.Rows.Sum(r => r.UnblockedAmount).ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                        <form asp-controller="Dashboard" asp-action="ConfirmAutomaticAllotment" method="post" onsubmit="return confirm('CONFIRM FINAL ALLOTMENT FOR @Model.Ipo.IPO_name?\n\n• @Model.Rows.Count(r => r.Result == "Full allotment") Full Allotments\n• @Model.Rows.Count(r => r.Result == "Partial allotment") Partial Allotments\n• @Model.Rows.Count(r => r.Result == "Not allotted") Non-Allotted\n• ₹@Model.Rows.Sum(r => r.AllocatedAmount).ToString("N2") to debit\n• ₹@Model.Rows.Sum(r => r.UnblockedAmount).ToString("N2") to unblock/refund\n\nAllotment results and CAN advice will be permanently locked and notifications dispatched to all applicants.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" />
                            <button class="btn btn-success px-4 py-2 fw-bold" type="submit">
                                &#10004; Confirm Final Allotment &amp; Publish Results
                            </button>
                        </form>
                        <a class="btn btn-outline-secondary px-3 py-2" asp-controller="Dashboard" asp-action="Applications" asp-route-ipoId="@Model.Ipo.IPO_id">
                            Cancel &amp; Return
                        </a>
                    </div>
                </div>
            }
        </section>
    </main>
</div>
