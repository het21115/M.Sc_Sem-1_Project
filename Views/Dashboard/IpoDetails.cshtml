@model IPOInvestmentManagement.Models.AdminIpoDetailsViewModel
@{
    ViewData["Title"] = "IPO Details";
    string scheduleStatus = Model.Ipo.Listing_date.HasValue && Model.Ipo.Listing_date.Value.Date <= DateTime.UtcNow.Date
        ? "Listed"
        : DateTime.UtcNow.Date < Model.Ipo.Open_date.Date
            ? "Scheduled"
            : DateTime.UtcNow.Date <= Model.Ipo.Close_date.Date ? "Open period" : "Closed period";
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Dashboard")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Admin")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">04 / IPO CONTROL</span><h1>@Model.Ipo.IPO_name</h1><p>View, publish, schedule, and manage this IPO offering.</p></div><div class="admin-status"><i></i> Administrator access</div></div>
        @if (TempData["AdminMessage"] is string adminMessage) { <div class="alert alert-info mt-3" role="alert">@adminMessage</div> }
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">IPO INFORMATION</span><h2>@Model.CompanyName</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Index" asp-fragment="ipo-requests">Back to IPO requests</a></div>
            <div class="admin-user-detail-grid">
                <div><span>IPO name</span><strong>@Model.Ipo.IPO_name</strong></div>
                <div><span>Company</span><strong>@Model.CompanyName</strong></div>
                <div><span>Status</span><strong>@(Model.Ipo.Status ?? "Pending")</strong></div>
                <div><span>Schedule</span><strong>@scheduleStatus</strong></div>
                <div><span>Opening date</span><strong>@Model.Ipo.Open_date.ToString("dd MMM yyyy") (@Model.Ipo.EffectiveOpeningTime.ToString(@"hh\:mm") IST)</strong></div>
                <div><span>Closing date</span><strong>@Model.Ipo.Close_date.ToString("dd MMM yyyy") (@Model.Ipo.EffectiveClosingTime.ToString(@"hh\:mm") IST)</strong></div>
                <div><span>Allotment date</span><strong>@(Model.Ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "Not provided")</strong></div>
                <div><span>Funds unblock date</span><strong>@(Model.Ipo.Funds_unblock_date?.ToString("dd MMM yyyy") ?? "Not provided")</strong></div>
                <div><span>Listing date</span><strong>@(Model.Ipo.Listing_date?.ToString("dd MMM yyyy") ?? "Not provided")</strong></div>
                <div><span>Total shares offered</span><strong>@(Model.Ipo.Total_shares?.ToString("N0") ?? "Not provided")</strong></div>
                <div><span>Lot size</span><strong>@(Model.Ipo.Lot_size.HasValue ? $"{Model.Ipo.Lot_size.Value:N0} shares" : "Not provided")</strong></div>
                <div><span>IPO type</span><strong>@(Model.Ipo.IPO_type ?? "Not provided")</strong></div>
                <div><span>Application type</span><strong>@(Model.Ipo.Apply_type ?? "Not provided")</strong></div>
                <div><span>Issue size</span><strong>₹@((Model.Ipo.Issue_size ?? 0).ToString("N2"))</strong></div>
                <div><span>Price range</span><strong>₹@(Model.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(Model.Ipo.Price_max?.ToString("N2") ?? "-")</strong></div>
                <div><span>Submitted</span><strong>@Model.Ipo.Created_at.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
            </div>
            <div class="admin-ipo-description">
                <span>Description</span>
                <p>@(string.IsNullOrWhiteSpace(Model.Ipo.Description) ? "Not provided" : Model.Ipo.Description)</p>
            </div>
            <div class="company-request-actions admin-detail-actions">
                @if (string.Equals(Model.Ipo.Status, "Pending", StringComparison.OrdinalIgnoreCase)) { <form asp-controller="Dashboard" asp-action="ApproveIpo" method="post"><input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" /><button class="btn btn-success" type="submit">Approve IPO</button></form> }
                @if (string.Equals(Model.Ipo.Status, "Approved", StringComparison.OrdinalIgnoreCase)) { <form asp-controller="Dashboard" asp-action="PublishIpo" method="post"><input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" /><button class="btn btn-success" type="submit">Publish IPO</button></form> }
                @if (!string.Equals(Model.Ipo.Status, "Rejected", StringComparison.OrdinalIgnoreCase) && !string.Equals(Model.Ipo.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) { <form asp-controller="Dashboard" asp-action="DenyIpo" method="post"><input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" /><button class="btn btn-outline-danger" type="submit" onclick="return confirm('Reject this IPO?');">Reject IPO</button></form><form asp-controller="Dashboard" asp-action="CancelIpo" method="post"><input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" /><button class="btn btn-outline-secondary" type="submit" onclick="return confirm('Cancel this IPO?');">Cancel IPO</button></form> }
            </div>
            <form class="admin-status-form" asp-controller="Dashboard" asp-action="ChangeIpoStatus" method="post"><input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" /><label for="status">Change IPO status</label><select id="status" name="status"><option selected="@(Model.Ipo.Status == "Pending")">Pending</option><option selected="@(Model.Ipo.Status == "Approved")">Approved</option><option selected="@(Model.Ipo.Status == "Upcoming")">Upcoming</option><option selected="@(Model.Ipo.Status == "Open")">Open</option><option selected="@(Model.Ipo.Status == "Closed")">Closed</option><option selected="@(Model.Ipo.Status == "Listed")">Listed</option><option selected="@(Model.Ipo.Status == "Rejected")">Rejected</option><option selected="@(Model.Ipo.Status == "Cancelled")">Cancelled</option></select><button class="btn btn-primary" type="submit">Update status</button></form>
        </section>

        <!-- AUTOMATIC STATUS & SCHEDULE CONFIGURATION (ADMIN) -->
        <section class="admin-user-details-card mt-4" style="border-top: 4px solid #0284c7;">
            <div class="admin-section-head">
                <div>
                    <span class="admin-overline" style="color: #0284c7;">SCHEDULE &amp; AUTOMATIC STATUS MANAGEMENT</span>
                    <h2>Configure IPO Opening &amp; Closing Schedule</h2>
                    <p class="text-muted mb-0">Set exact opening and closing dates and times in Indian Standard Time (IST). The system automatically transitions the IPO status between <strong>Upcoming</strong>, <strong>Open</strong>, and <strong>Closed</strong>.</p>
                </div>
            </div>
            <form asp-controller="Dashboard" asp-action="UpdateIpoSchedule" method="post" class="p-3 bg-light rounded border mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" />
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Opening Date (IST)</label>
                        <input type="date" name="openDate" class="form-control form-control-sm" value="@Model.Ipo.Open_date.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Opening Time (IST)</label>
                        <input type="time" name="openTime" class="form-control form-control-sm" value="@Model.Ipo.EffectiveOpeningTime.ToString(@"hh\:mm")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Closing Date (IST)</label>
                        <input type="date" name="closeDate" class="form-control form-control-sm" value="@Model.Ipo.Close_date.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Closing Time (IST)</label>
                        <input type="time" name="closeTime" class="form-control form-control-sm" value="@Model.Ipo.EffectiveClosingTime.ToString(@"hh\:mm")" required />
                    </div>
                </div>
                <div class="mt-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="small text-muted">
                        Current Status: <span class="badge bg-primary">@(Model.Ipo.Status ?? "Upcoming")</span>
                        &middot; Bidding Window: <strong>@Model.Ipo.OpeningDateTime.ToString("dd MMM yyyy, hh:mm tt")</strong> to <strong>@Model.Ipo.ClosingDateTime.ToString("dd MMM yyyy, hh:mm tt") IST</strong>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Update Schedule &amp; Recalculate Status</button>
                </div>
            </form>
        </section>

        <!-- AUDIT LOG & STATUS TRANSITION HISTORY -->
        <section class="admin-user-details-card mt-4">
            <div class="admin-section-head d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="admin-overline">AUDIT RECORD</span>
                    <h2>Status Transition &amp; Action History</h2>
                    <p class="text-muted mb-0">Historical log of automatic transitions and administrative updates for this IPO.</p>
                </div>
                <span class="badge bg-secondary">@Model.AuditHistory.Count Record(s)</span>
            </div>
            @if (Model.AuditHistory.Count == 0)
            {
                <div class="admin-empty py-3 text-muted">No audit logs recorded for this IPO yet.</div>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-hover align-middle border mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp (IST)</th>
                                <th>Action</th>
                                <th>Actor</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.AuditHistory)
                            {
                                <tr>
                                    <td><small class="fw-bold">@TimeZoneInfo.ConvertTimeFromUtc(log.CreatedAt, TimeZoneInfo.FindSystemTimeZoneById("India Standard Time")).ToString("dd MMM yyyy, hh:mm:ss tt")</small></td>
                                    <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                    <td><small>@(log.ActorUserId.HasValue ? $"Admin #{log.ActorUserId}" : "System (Background Service)")</small></td>
                                    <td><small class="text-break">@log.Details</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- GREY MARKET PREMIUM (GMP) MANAGEMENT (UNOFFICIAL) -->
        <section class="admin-user-details-card gmp-tracker-card mt-4" id="admin-gmp-section">
            <div class="admin-section-head d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <span class="admin-overline text-warning font-monospace">UNOFFICIAL MARKET DATA &middot; GREY MARKET DESK</span>
                    <h2>Grey Market Premium (GMP) Tracking &amp; History</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark border px-3 py-2 fw-bold">
                        ⚠️ UNOFFICIAL &middot; INDICATIVE ONLY
                    </span>
                </div>
            </div>

            <!-- Prominent Unofficial Disclaimer -->
            <div class="alert alert-warning gmp-disclaimer-box d-flex align-items-start gap-3 my-3 p-3 rounded-3">
                <span class="fs-4">⚠️</span>
                <div>
                    <strong class="d-block mb-1">Administrative Advisory &amp; Statutory Disclaimer: GMP is Unofficial</strong>
                    <small class="d-block" style="line-height: 1.45;">
                        Grey Market Premium (GMP) quotations are strictly unofficial, unregulated peer-to-peer data. 
                        <strong>SEBI, NSE, and BSE do not regulate, monitor, or recognize grey market transactions</strong>. 
                        Estimated listing prices calculated here are purely indicative reference numbers and do not guarantee actual listing prices.
                    </small>
                </div>
            </div>

            <!-- GMP Overview Cards -->
            <div class="gmp-metrics-grid mb-4">
                <div class="gmp-stat-card current-gmp">
                    <span class="gmp-stat-label">Current GMP <small class="text-muted">(Unofficial)</small></span>
                    <div class="gmp-stat-val text-success">
                        <span class="gmp-currency">₹</span>@(Model.CurrentGmp?.GMPPrice.ToString("N2") ?? "0.00")
                    </div>
                    <div class="gmp-stat-sub">
                        @if (Model.GmpChange > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success">
                                ▲ +₹@Model.GmpChange.ToString("N2") (+@Model.GmpChangePercentage%)
                            </span>
                        }
                        else if (Model.GmpChange < 0)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                ▼ -₹@Math.Abs(Model.GmpChange).ToString("N2") (@Model.GmpChangePercentage%)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">Flat (0.00)</span>
                        }
                        <span class="text-muted ms-1">vs prev quote</span>
                    </div>
                </div>

                <div class="gmp-stat-card">
                    <span class="gmp-stat-label">Previous GMP <small class="text-muted">(Last Recorded)</small></span>
                    <div class="gmp-stat-val text-secondary">
                        <span class="gmp-currency">₹</span>@(Model.PreviousGmp?.GMPPrice.ToString("N2") ?? Model.CurrentGmp?.GMPPrice.ToString("N2") ?? "-")
                    </div>
                    <div class="gmp-stat-sub text-muted">
                        Recorded on @(Model.PreviousGmp?.RecordedDate.ToString("dd MMM yyyy") ?? Model.CurrentGmp?.RecordedDate.ToString("dd MMM yyyy") ?? "N/A")
                    </div>
                </div>

                <div class="gmp-stat-card highlight">
                    <span class="gmp-stat-label">Estimated Listing Price <small class="text-muted">(Unofficial)</small></span>
                    <div class="gmp-stat-val text-primary">
                        <span class="gmp-currency">₹</span>@Model.EstimatedListingPrice.ToString("N2")
                    </div>
                    <div class="gmp-stat-sub">
                        <span class="badge bg-primary-subtle text-primary border border-primary">
                            +@Model.EstimatedGainPercentage% Est. Listing Gain
                        </span>
                        <small class="text-muted ms-1">Base: ₹@(Model.Ipo.Price_max?.ToString("N2") ?? Model.Ipo.Price_min?.ToString("N2") ?? "-")</small>
                    </div>
                </div>
            </div>

            <!-- Historical Chart Viewport -->
            <div class="gmp-chart-container mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <h4 class="m-0 fs-6 fw-bold">GMP Historical Trend Line (Unofficial)</h4>
                        <small class="text-muted">Visual movement of unofficial premium quotes over time</small>
                    </div>
                    <span class="badge bg-light text-dark border">
                        @Model.GmpHistory.Count recorded quote(s)
                    </span>
                </div>
                
                <div class="gmp-chart-viewport position-relative" style="height: 240px; background: #fafbfc; border: 1px solid #e1e4e8; border-radius: 8px; padding: 10px;">
                    <canvas id="admin-gmp-chart" style="width: 100%; height: 100%; display: block;"></canvas>
                    <div id="admin-gmp-tooltip" class="gmp-tooltip hidden"></div>
                </div>
            </div>

            <!-- Admin Entry Form: Add New Daily GMP Quote -->
            <div class="card p-3 mb-4 bg-light border">
                <h4 class="fs-6 fw-bold mb-2">Record New Daily GMP Quote (Unofficial)</h4>
                <form asp-controller="Dashboard" asp-action="AddGmpRecord" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" />
                    
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Quotation Date</label>
                        <input type="date" name="recordedDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">GMP Premium (₹ / share)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.5" name="gmpPrice" class="form-control" placeholder="e.g. 45.00" required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Quotation Source / Note</label>
                        <input type="text" name="source" class="form-control form-control-sm" value="Unofficial Grey Market Desk" />
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            + Add GMP Quote
                        </button>
                    </div>
                </form>
            </div>

            <!-- GMP History Log Table with Delete Option -->
            @if (Model.GmpHistory.Count > 0)
            {
                <div class="gmp-history-table-container">
                    <h4 class="fs-6 fw-bold mb-2">Recorded GMP History Log</h4>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle border mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Recorded Date</th>
                                    <th>GMP (₹)</th>
                                    <th>Cap Price (₹)</th>
                                    <th>Est. Listing Price (₹)</th>
                                    <th>Est. Gain (%)</th>
                                    <th>Source</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.GmpHistory.OrderByDescending(r => r.RecordedDate).ThenByDescending(r => r.Gmp_id))
                                {
                                    <tr>
                                        <td><strong>@record.RecordedDate.ToString("dd MMM yyyy")</strong></td>
                                        <td><span class="badge bg-success-subtle text-success border border-success fw-bold">₹@record.GMPPrice.ToString("N2")</span></td>
                                        <td>₹@(Model.Ipo.Price_max?.ToString("N2") ?? Model.Ipo.Price_min?.ToString("N2") ?? "-")</td>
                                        <td><strong>₹@(record.EstimatedListingPrice?.ToString("N2") ?? ((Model.Ipo.Price_max ?? 0) + record.GMPPrice).ToString("N2"))</strong></td>
                                        <td>
                                            <span class="text-success fw-bold">+@(record.ExpectedListingGainPercentage?.ToString("N2") ?? "0.00")%</span>
                                        </td>
                                        <td><small class="text-muted">@(record.Source ?? "Unofficial Desk")</small></td>
                                        <td class="text-end">
                                            <form asp-controller="Dashboard" asp-action="DeleteGmpRecord" method="post" class="d-inline" onsubmit="return confirm('Delete this GMP record?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gmpId" value="@record.Gmp_id" />
                                                <input type="hidden" name="ipoId" value="@Model.Ipo.IPO_id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    </main>
</div>

<script src="~/js/gmp-tracker.js" asp-append-version="true"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var gmpData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.GmpHistory.OrderBy(g => g.RecordedDate).ThenBy(g => g.Gmp_id).Select(g => new {
                date = g.RecordedDate.ToString("dd MMM"),
                fullDate = g.RecordedDate.ToString("dd MMM yyyy"),
                gmp = g.GMPPrice,
                estimatedPrice = g.EstimatedListingPrice ?? ((Model.Ipo.Price_max ?? Model.Ipo.Price_min ?? 0) + g.GMPPrice),
                gainPct = g.ExpectedListingGainPercentage ?? 0m
            })
        ));
        if (typeof window.initGmpHistoricalChart === "function") {
            window.initGmpHistoricalChart("admin-gmp-chart", "admin-gmp-tooltip", gmpData);
        }
    });
</script>
