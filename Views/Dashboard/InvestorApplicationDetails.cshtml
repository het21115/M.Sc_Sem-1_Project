@model IPOInvestmentManagement.Models.AdminApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
    var application = Model.Application;
    var ipo = Model.Ipo;
    var allotment = Model.Allotment;
    bool canCancel = allotment is null &&
        string.Equals(application.Status, "Submitted", StringComparison.OrdinalIgnoreCase) &&
        DateTime.UtcNow.AddHours(5.5).Date < ipo.Close_date.Date;
}

<div class="registration-form-shell">
    <div class="registration-form-intro registration-form-intro-investor">
        <p class="gateway-kicker"><span></span> Application history</p>
        <h1>@ipo.IPO_name</h1>
        <p>Review your application, payment reference, and allotment outcome.</p>
    </div>
    <div class="card registration-form-card">
        <div class="card-body p-4 p-lg-5">
            @if (TempData["InvestorMessage"] is string message)
            {
                <div class="alert alert-info" role="alert">@message</div>
            }
            <div class="investor-payment-summary">
                <p><span>Application number</span><strong>@(application.Application_number ?? $"#{application.Application_id}")</strong></p>
                <p><span>Application status</span><strong>@(application.Status ?? "Pending")</strong></p>
                <p><span>Payment status</span><strong>@(application.Payment_status ?? "Pending Payment")</strong></p>
                <p>
                    <span>Payment workflow</span>
                    <strong>
                        @if (Model.Payment?.IsSimulated ?? application.Is_simulated_payment ?? true)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">🧪 Simulated UPI ASBA Mandate</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success">💳 Genuine Payment Gateway</span>
                        }
                    </strong>
                </p>
                <p><span>Application date</span><strong>@application.Application_date.AddHours(5.5).ToString("dd MMM yyyy, hh:mm tt") IST</strong></p>
                <p><span>Lots / shares</span><strong>@application.Applied_lots / @application.Applied_shares</strong></p>
                <p><span>Bid price</span><strong>₹@((application.Bid_price ?? 0m).ToString("N2"))</strong></p>
                <p><span>Application amount</span><strong>₹@((application.Application_amount ?? 0m).ToString("N2"))</strong></p>
                <p><span>Razorpay order ID</span><strong class="font-monospace small">@(application.Razorpay_order_id ?? "Not recorded")</strong></p>
                <p><span>Transaction ID</span><strong class="font-monospace text-primary">@(application.Razorpay_payment_id ?? application.Payment_reference ?? "Not recorded")</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.Payment?.ReceiptNumber ?? application.Receipt_number))
                {
                    <p><span>Receipt number</span><strong class="font-monospace">@(Model.Payment?.ReceiptNumber ?? application.Receipt_number)</strong></p>
                }
            </div>

            @if (Model.Payment is not null && (Model.Payment.UnblockedAmount > 0 || Model.Payment.RefundStatus == "Completed" || Model.Payment.RefundStatus == "Pending Unblock"))
            {
                <div class="card bg-light border mb-3 mt-3">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 text-primary">Mandate Unblock / Refund Status</h6>
                                <p class="mb-0 small text-muted">
                                    Refund Status: <strong class="text-dark">@Model.Payment.RefundStatus</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.Payment.RefundReferenceId))
                                    {
                                        <span>&middot; Ref: <strong class="font-monospace">@Model.Payment.RefundReferenceId</strong></span>
                                    }
                                    @if (Model.Payment.RefundProcessedAt.HasValue)
                                    {
                                        <span>&middot; Processed: @Model.Payment.RefundProcessedAt.Value.ToString("dd MMM yyyy")</span>
                                    }
                                </p>
                            </div>
                            <div class="text-end">
                                <span class="badge @(Model.Payment.RefundStatus == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @(Model.Payment.RefundStatus == "Completed" ? "Unblocked" : "Pending")
                                </span>
                                <div class="fw-bold fs-5 text-success">₹@Model.Payment.UnblockedAmount.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (allotment is not null)
            {
                <div class="card border mb-3 mt-3 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                    <div class="card-header @(allotment.Status == "Allotted" ? "bg-success" : allotment.Status == "Partially Allotted" ? "bg-primary" : "bg-secondary") text-white d-flex justify-content-between align-items-center py-2">
                        <strong class="fs-6">&#128737; Official Allotment Outcome: @allotment.Status</strong>
                        <span class="badge bg-light text-dark font-monospace">@(allotment.Advice_number ?? "CAN Issued")</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-sm-3">
                                <small class="text-muted d-block">Allotted Shares</small>
                                <strong class="fs-5 @(allotment.Allotted_shares > 0 ? "text-success" : "text-muted")">
                                    @allotment.Allotted_shares.ToString("N0") shares
                                </strong>
                                <small class="text-muted d-block">(@allotment.Allotted_lots lot(s))</small>
                            </div>
                            <div class="col-sm-3">
                                <small class="text-muted d-block">Cut-Off Allotment Price</small>
                                <strong class="fs-5 text-dark">₹@allotment.Allotment_price.ToString("N2")</strong>
                            </div>
                            <div class="col-sm-3">
                                <small class="text-muted d-block">Total Debited Amount</small>
                                <strong class="fs-5 text-success">₹@allotment.Debited_amount.ToString("N2")</strong>
                            </div>
                            <div class="col-sm-3">
                                <small class="text-muted d-block">Funds Unblocked / Refund</small>
                                <strong class="fs-5 text-warning">₹@allotment.Unblocked_amount.ToString("N2")</strong>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Dashboard" asp-action="AllotmentAdvice" asp-route-applicationId="@application.Application_id">
                                &#128196; View Confirmation Note (CAN)
                            </a>
                            <a class="btn btn-success btn-sm" asp-controller="Dashboard" asp-action="DownloadAllotmentAdvicePdf" asp-route-applicationId="@application.Application_id" target="_blank">
                                &#128190; Download Allotment Advice (PDF)
                            </a>
                        </div>
                    </div>
                </div>
            }
            @if (application.Status == "Cancelled")
            {
                <div class="alert alert-warning">
                    Cancelled on @application.Cancellation_date?.ToString("dd MMM yyyy, hh:mm tt").
                    Reason: @application.Cancellation_reason
                </div>
            }
            @if (canCancel)
            {
                <form asp-controller="Dashboard" asp-action="CancelInvestorApplication" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ApplicationId" value="@application.Application_id" />
                    <label class="form-label" for="cancellation-reason">Cancellation reason</label>
                    <textarea class="form-control mb-3" id="cancellation-reason" name="Reason" minlength="5" maxlength="500" required></textarea>
                    <button class="btn btn-outline-danger" type="submit">Cancel application</button>
                </form>
            }
            else if (application.Status == "Submitted" && allotment is null)
            {
                <p class="text-muted mt-4">Cancellation is available only before the IPO closing date.</p>
            }
            <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
                @if (Model.Payment is not null)
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Dashboard" asp-action="PaymentReceipt" asp-route-paymentRecordId="@Model.Payment.PaymentRecordId" target="_blank">
                        📄 View / Print Official Receipt
                    </a>
                }
                <a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="DownloadIpoApplicationReportPdf" target="_blank">
                    📄 Download Application Report (PDF)
                </a>
                <a class="btn btn-sm btn-outline-success" asp-controller="Dashboard" asp-action="DownloadAllotmentReportPdf" target="_blank">
                    📄 Download Allotment Report (PDF)
                </a>
            </div>
            <a class="registration-back-link mt-3" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
        </div>
    </div>
</div>
