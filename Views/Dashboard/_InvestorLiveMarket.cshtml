@model IPOInvestmentManagement.Models.DashboardViewModel

<div class="investor-live-market-card">
    <div class="live-market-copy">
        <span class="terminal-overline"><i></i> LIVE MARKET</span>
        <strong>Market pulse, at a glance</strong>
        <small>Simulated trading using stored market data only.</small>
    </div>
    <div class="live-market-highlights" aria-label="Live market summary">
        <span class="live-market-stat-offers"><b>@Model.Market.Listings.Count</b><small>Listed stocks</small></span>
        <span class="live-market-stat-listed"><b>@Model.Market.TopGainers.Count</b><small>Top gainers</small></span>
        <span class="live-market-stat-open"><b class="@(Model.Market.IsMarketOpen ? "live-market-positive" : "live-market-negative")"><i></i> @Model.Market.MarketStatus</b><small>Market status</small></span>
    </div>
    <button type="button" class="btn investor-live-market-button" data-bs-toggle="modal" data-bs-target="#live-market-modal">Explore live market <span aria-hidden="true">&#8594;</span></button>
</div>

<div class="modal fade investor-modal" id="live-market-modal" tabindex="-1" aria-labelledby="live-market-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="live-market-modal-title"><span class="live-market-dot"></span>Live Market</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="investor-modal-intro">Market status uses IST 09:30–15:30 and administrator-managed holidays. No prices are generated by the application.</p>
                @if (Model.Market.Listings.Count == 0)
                {
                    <div class="terminal-empty">No listed market data is available yet.</div>
                }
                else
                {
                    <div class="investor-live-market-list">
                        @foreach (var row in Model.Market.Listings)
                        {
                            <div class="investor-live-market-row">
                                <div class="live-market-ipo-name"><span class="live-market-ipo-icon" aria-hidden="true">&#9670;</span><div><strong>@row.CompanyName</strong><small>@row.StockSymbol @row.Exchange &middot; @row.IpoName</small></div></div>
                                <span class="live-market-price"><b>₹@(row.CurrentPrice?.ToString("N2") ?? "Market data unavailable")</b><small>Issue ₹@(row.IssuePrice?.ToString("N2") ?? "-") · Listing ₹@(row.ListingPrice?.ToString("N2") ?? "-")</small></span>
                                <span class="live-market-price @(row.PriceChange >= 0 ? "live-market-positive" : "live-market-negative")">@(row.PriceChange.HasValue ? $"{(row.PriceChange >= 0 ? "+" : "")}₹{row.PriceChange:N2}" : "-") (@(row.PriceChangePercentage?.ToString("N2") ?? "-")%)</span>
                                <em>@(row.IsMarketOpen ? "Market Open" : "Market Closed") · @(row.LastUpdated?.ToString("dd MMM yyyy HH:mm") ?? "Not updated")</em>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer"><small class="live-market-disclaimer">@(Model.Market.IsMarketOpen ? "Market is currently open." : "Market is closed. Showing the latest available stored close.")</small><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>
