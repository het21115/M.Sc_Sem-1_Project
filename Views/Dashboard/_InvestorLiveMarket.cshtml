@model IPOInvestmentManagement.Models.DashboardViewModel

<div class="modal fade investor-modal" id="live-market-modal" tabindex="-1" aria-labelledby="live-market-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title" id="live-market-modal-title">
                        <span class="ticker-pulse" style="@(Model.Market.IsMarketOpen ? "" : "background:#ef4444; box-shadow:0 0 6px #ef4444;")"></span>
                        Live NSE · BSE Market Terminal
                    </h2>
                    <small class="text-muted" id="live-market-modal-subtitle">
                        @(Model.Market.IsMarketOpen 
                            ? "Active Market Session (09:30 AM – 03:30 PM IST) • Streaming real-time quotes" 
                            : "Market Session Closed • Official Trading Hours: Monday – Friday, 09:30 AM to 03:30 PM IST")
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="live-market-modal-body">
                @if (!Model.Market.IsMarketOpen)
                {
                    <div class="market-closed-panel text-center py-5 px-3" style="background:#0c1524; border-radius:12px; border:1px solid #1e334d;">
                        <div class="mb-3">
                            <span style="display:inline-flex; align-items:center; justify-content:center; width:68px; height:68px; border-radius:50%; background:rgba(239, 68, 68, 0.12); border:2px solid #ef4444; color:#ef4444; font-size:2rem;">
                                &#9200;
                            </span>
                        </div>
                        <h3 class="text-white fw-bold mb-2">Live Market is Currently Closed</h3>
                        <p class="text-muted mx-auto mb-4" style="max-width:540px; font-size:0.95rem;">
                            Live share prices and real-time dual-exchange feeds are visible exclusively during official market trading hours.
                        </p>

                        <div class="market-hours-card text-start d-inline-block p-4 mb-4" style="background:#132032; border-radius:8px; border:1px solid #1e3a5f; min-width:320px; max-width:480px;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small">Trading Days:</span>
                                <strong class="text-white small">Monday &ndash; Friday</strong>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small">Official Hours:</span>
                                <strong class="text-warning small">09:30 AM &ndash; 03:30 PM IST</strong>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small">Exchanges:</span>
                                <strong class="text-white small">NSE (National) &amp; BSE (Bombay)</strong>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted small">Next Session Opens:</span>
                                <strong class="text-success small">09:30 AM IST (Next Trading Day)</strong>
                            </div>
                        </div>

                        <div>
                            <span class="badge bg-secondary px-3 py-2">
                                Market Session: Closed (Available only during 09:30 AM – 03:30 PM IST)
                            </span>
                        </div>
                    </div>
                }
                else if (Model.Market.Listings.Count == 0)
                {
                    <div class="terminal-empty">No listed stocks available yet. Once an IPO listing date arrives, live dual-exchange quotes stream automatically.</div>
                }
                else
                {
                    <div class="live-market-active-view">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 mb-3" style="background:#132235; border-radius:8px; border:1px solid #1e3a5f;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="ticker-pulse" style="width:10px; height:10px; background:#10b981;"></span>
                                <div>
                                    <strong class="text-success" style="font-size:0.9rem;">LIVE TRADING SESSION ACTIVE</strong>
                                    <div class="text-muted" style="font-size:0.75rem;">Official Hours: 09:30 AM &ndash; 03:30 PM IST &middot; Real-Time Dual-Exchange Quotes (NSE &amp; BSE)</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-dark border border-secondary text-light px-2 py-1" style="font-size:0.75rem;">NSE LIVE</span>
                                <span class="badge bg-dark border border-secondary text-light px-2 py-1" style="font-size:0.75rem;">BSE LIVE</span>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0" style="background:#101c2c; border-radius:6px; overflow:hidden;">
                                <thead style="background:#17283d; font-size:0.75rem; letter-spacing:0.04em; color:#94a3b8;">
                                    <tr>
                                        <th>STOCK / COMPANY</th>
                                        <th>NSE PRICE (₹)</th>
                                        <th>NSE CHANGE</th>
                                        <th>BSE PRICE (₹)</th>
                                        <th>BSE CHANGE</th>
                                        <th>DAY RANGE</th>
                                        <th>VOLUME</th>
                                        <th>QUICK TRADE</th>
                                    </tr>
                                </thead>
                                <tbody style="font-size:0.85rem;" id="market-listings-tbody">
                                    @foreach (var row in Model.Market.Listings)
                                    {
                                        decimal nseP = row.NsePrice ?? row.CurrentPrice ?? 0m;
                                        decimal bseP = row.BsePrice ?? row.CurrentPrice ?? 0m;
                                        decimal nseChg = row.NsePriceChange ?? row.PriceChange ?? 0m;
                                        decimal bseChg = row.BsePriceChange ?? row.PriceChange ?? 0m;
                                        decimal nsePct = row.NsePriceChangePercentage ?? row.PriceChangePercentage ?? 0m;
                                        decimal bsePct = row.BsePriceChangePercentage ?? row.PriceChangePercentage ?? 0m;

                                        <tr style="border-bottom:1px solid #1e334d; cursor:pointer;" data-market-row="@row.IpoId"
                                            onclick="window.openStockLiveChart(@row.IpoId, '@row.StockSymbol', '@row.CompanyName.Replace("'", "\\'")', '@row.IpoName.Replace("'", "\\'")')"
                                            title="Click to view real-time chart for @row.StockSymbol">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="ticker-pulse" style="width:6px; height:6px;"></span>
                                                    <div>
                                                        <strong class="text-white">@row.StockSymbol</strong>
                                                        <div class="text-muted small" style="font-size:0.75rem;">@row.CompanyName &middot; @row.IpoName</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="exchange-badge-nse">NSE</span>
                                                <strong class="text-white" data-nse-price="@row.IpoId">₹@nseP.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <span class="@(nseChg >= 0 ? "profit" : "loss") fw-bold" data-nse-change="@row.IpoId">
                                                    @(nseChg >= 0 ? "+" : "")₹@nseChg.ToString("N2") (@(nsePct >= 0 ? "+" : "")@nsePct.ToString("F2")%)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="exchange-badge-bse">BSE</span>
                                                <strong class="text-white" data-bse-price="@row.IpoId">₹@bseP.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <span class="@(bseChg >= 0 ? "profit" : "loss") fw-bold" data-bse-change="@row.IpoId">
                                                    @(bseChg >= 0 ? "+" : "")₹@bseChg.ToString("N2") (@(bsePct >= 0 ? "+" : "")@bsePct.ToString("F2")%)
                                                </span>
                                            </td>
                                            <td class="text-muted small" data-live-highlow="@row.IpoId">
                                                ₹@(row.DayHigh?.ToString("N2") ?? "-") / ₹@(row.DayLow?.ToString("N2") ?? "-")
                                            </td>
                                            <td class="text-muted small" data-live-volume="@row.IpoId">
                                                @((row.Volume ?? 0).ToString("N0"))
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" onclick="event.stopPropagation()">
                                                    <button type="button" class="btn btn-sm btn-outline-info" 
                                                            onclick="window.openStockLiveChart(@row.IpoId, '@row.StockSymbol', '@row.CompanyName.Replace("'", "\\'")', '@row.IpoName.Replace("'", "\\'")')"
                                                            title="View Live Chart">
                                                        📈 Chart
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-success" 
                                                            onclick="window.openFastTrade(@row.IpoId, '@row.IpoName.Replace("'", "\\'")', '@row.StockSymbol', @nseP, @bseP, 0, null, 'BUY')"
                                                            title="Instant Simulated Buy">
                                                        Buy
                                                    </button>
                                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Dashboard" asp-action="MarketDetails" asp-route-ipoId="@row.IpoId">
                                                        Details
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="market-stream-indicator @(Model.Market.IsMarketOpen ? "online" : "offline")"></span>
                    <small class="text-muted market-stream-label">
                        @(Model.Market.IsMarketOpen ? "● LIVE FEED CONNECTED (NSE & BSE)" : "○ MARKET CLOSED (09:30 - 15:30 IST)")
                    </small>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Groww-Style Real-time Stock Live Chart Modal -->
<div class="modal fade stock-chart-modal" id="stock-live-chart-modal" tabindex="-1" aria-labelledby="stock-chart-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content stock-chart-modal-content">
            <!-- Top App Bar -->
            <div class="stock-chart-topbar">
                <button type="button" class="stock-chart-back-btn" onclick="window.closeStockLiveChart()" title="Back to Live Market">
                    <span class="back-arrow">&#8592;</span>
                </button>
                <div class="stock-chart-top-actions">
                    <button type="button" class="top-icon-btn" title="Market Session Hours: 09:30 AM - 03:30 PM IST">
                        <span class="icon">&#9200;</span>
                    </button>
                    <button type="button" class="top-icon-btn" id="chart-bookmark-btn" onclick="window.toggleCurrentChartWatchlist()" title="Add to Watchlist">
                        <span class="icon" id="chart-bookmark-icon">&#128278;</span>
                    </button>
                    <button type="button" class="top-icon-btn" data-bs-toggle="modal" data-bs-target="#search-ipo-modal" title="Search stocks">
                        <span class="icon">&#128269;</span>
                    </button>
                    <button type="button" class="btn-close btn-close-white ms-2" onclick="window.closeStockLiveChart()" aria-label="Close"></button>
                </div>
            </div>

            <div class="modal-body stock-chart-body">
                <!-- Stock Identity -->
                <div class="stock-identity-row">
                    <div class="stock-logo-wrap" id="chart-stock-logo">
                        <span class="stock-logo-text" id="chart-logo-initials">AR</span>
                    </div>
                    <div class="stock-name-meta">
                        <div class="stock-sym-exchange">
                            <span class="stock-symbol-text" id="chart-symbol-text">ARDEE</span>
                            <span class="dot-sep">&bull;</span>
                            <button type="button" class="chart-exchange-switcher" id="chart-exchange-switch-btn" onclick="window.toggleChartExchange()" title="Switch Exchange (NSE / BSE)">
                                <span id="chart-exchange-label">NSE</span>
                                <span class="exchange-arrows">&#8645;</span>
                            </button>
                        </div>
                        <h2 class="stock-company-heading" id="chart-company-text">Ardee Industries</h2>
                    </div>
                </div>

                <!-- Big Price & Change Display -->
                <div class="stock-price-block">
                    <div class="stock-main-price" id="chart-main-price">&#8377;45.86</div>
                    <div class="stock-price-change" id="chart-price-delta">
                        <span class="delta-val" id="chart-delta-val">+0.00</span>
                        <span class="delta-pct" id="chart-delta-pct">(0.00%)</span>
                        <span class="delta-tf" id="chart-delta-tf">1D</span>
                    </div>
                </div>

                <!-- Chart Canvas Area -->
                <div class="stock-chart-viewport" id="chart-viewport">
                    <canvas id="stock-live-canvas" width="760" height="300"></canvas>
                    <div id="stock-chart-crosshair" class="chart-crosshair hidden"></div>
                    <div id="stock-chart-tooltip" class="chart-tooltip-box hidden">
                        <div class="tooltip-price" id="tt-price">&#8377;0.00</div>
                        <div class="tooltip-time" id="tt-time">--:--</div>
                    </div>
                    <div class="chart-prev-close-pill" id="chart-prev-close-pill">
                        Prev. Close: <strong id="chart-prev-close-val">&#8377;0.00</strong>
                    </div>
                    <button type="button" class="chart-view-toggle-btn" id="chart-view-toggle" onclick="window.toggleCandleView()" title="Toggle Candlestick / Line View">
                        <span id="chart-view-toggle-icon">&#128200;</span>
                    </button>
                </div>

                <!-- Timeframe Selector Pills -->
                <div class="stock-timeframe-bar" id="stock-timeframe-bar">
                    <button type="button" class="tf-pill active" data-tf="1D" onclick="window.selectChartTf('1D')">1D</button>
                    <button type="button" class="tf-pill" data-tf="1W" onclick="window.selectChartTf('1W')">1W</button>
                    <button type="button" class="tf-pill" data-tf="1M" onclick="window.selectChartTf('1M')">1M</button>
                    <button type="button" class="tf-pill" data-tf="3M" onclick="window.selectChartTf('3M')">3M</button>
                    <button type="button" class="tf-pill" data-tf="6M" onclick="window.selectChartTf('6M')">6M</button>
                    <button type="button" class="tf-pill" data-tf="1Y" onclick="window.selectChartTf('1Y')">1Y</button>
                    <button type="button" class="tf-pill" data-tf="5Y" onclick="window.selectChartTf('5Y')">5Y</button>
                    <button type="button" class="tf-pill" data-tf="ALL" onclick="window.selectChartTf('ALL')">All</button>
                </div>

                <!-- Section Navigation Tabs -->
                <div class="stock-nav-tabs">
                    <button type="button" class="stock-tab-btn active" data-tab="overview" onclick="window.switchStockChartTab('overview')">Overview</button>
                    <button type="button" class="stock-tab-btn" data-tab="technicals" onclick="window.switchStockChartTab('technicals')">Technicals</button>
                    <button type="button" class="stock-tab-btn" data-tab="news" onclick="window.switchStockChartTab('news')">News</button>
                    <button type="button" class="stock-tab-btn" data-tab="events" onclick="window.switchStockChartTab('events')">Events</button>
                </div>

                <!-- Tab 1: Overview -->
                <div class="stock-tab-content" id="tab-content-overview">
                    <div class="performance-section-head">
                        <h3>Performance <span class="info-bubble" title="Trading session low, high and 52-week metrics">&#9432;</span></h3>
                    </div>

                    <!-- Range 1: Today's Low / High -->
                    <div class="range-metric-card">
                        <div class="range-labels">
                            <div>
                                <span class="range-sub">Today's Low</span>
                                <strong id="perf-today-low">&#8377;0.00</strong>
                            </div>
                            <div class="text-end">
                                <span class="range-sub">Today's High</span>
                                <strong id="perf-today-high">&#8377;0.00</strong>
                            </div>
                        </div>
                        <div class="range-bar-track">
                            <div class="range-bar-fill" id="perf-today-bar" style="width:50%;"></div>
                            <span class="range-pointer" id="perf-today-pointer" style="left:50%;"></span>
                        </div>
                    </div>

                    <!-- Range 2: 52-Week Low / High -->
                    <div class="range-metric-card mt-3">
                        <div class="range-labels">
                            <div>
                                <span class="range-sub">52-Week Low</span>
                                <strong id="perf-52w-low">&#8377;0.00</strong>
                            </div>
                            <div class="text-end">
                                <span class="range-sub">52-Week High</span>
                                <strong id="perf-52w-high">&#8377;0.00</strong>
                            </div>
                        </div>
                        <div class="range-bar-track">
                            <div class="range-bar-fill" id="perf-52w-bar" style="width:65%;"></div>
                            <span class="range-pointer" id="perf-52w-pointer" style="left:65%;"></span>
                        </div>
                    </div>

                    <!-- Market Stats Grid -->
                    <div class="stock-fundamentals-grid mt-4">
                        <div class="fund-item">
                            <span>Open Price</span>
                            <strong id="perf-open">&#8377;0.00</strong>
                        </div>
                        <div class="fund-item">
                            <span>Prev. Close</span>
                            <strong id="perf-prev-close">&#8377;0.00</strong>
                        </div>
                        <div class="fund-item">
                            <span>Volume</span>
                            <strong id="perf-volume">0</strong>
                        </div>
                        <div class="fund-item">
                            <span>Lower Circuit</span>
                            <strong id="perf-lower-circuit" class="text-danger">&#8377;0.00</strong>
                        </div>
                        <div class="fund-item">
                            <span>Upper Circuit</span>
                            <strong id="perf-upper-circuit" class="text-success">&#8377;0.00</strong>
                        </div>
                        <div class="fund-item">
                            <span>Best Bid / Ask</span>
                            <strong id="perf-bid-ask">&#8377;0.00 / &#8377;0.00</strong>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Technicals -->
                <div class="stock-tab-content hidden" id="tab-content-technicals">
                    <div class="technicals-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted small">Technical Trend Summary</span>
                            <span class="badge bg-success" id="tech-summary-badge">BULLISH</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <div class="tech-box">
                                    <small>RSI (14)</small>
                                    <strong id="tech-rsi">54.20</strong>
                                    <span class="badge bg-secondary mt-1">Neutral</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tech-box">
                                    <small>MACD (12, 26)</small>
                                    <strong class="text-success" id="tech-macd">+1.25</strong>
                                    <span class="badge bg-success mt-1">Buy</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tech-box">
                                    <small>20-DMA</small>
                                    <strong id="tech-sma20">&#8377;0.00</strong>
                                    <span class="badge bg-info mt-1">Above</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="tech-box">
                                    <small>50-DMA</small>
                                    <strong id="tech-sma50">&#8377;0.00</strong>
                                    <span class="badge bg-info mt-1">Above</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab 3: News -->
                <div class="stock-tab-content hidden" id="tab-content-news">
                    <div class="stock-news-list" id="stock-news-container">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- Tab 4: Events -->
                <div class="stock-tab-content hidden" id="tab-content-events">
                    <div class="stock-events-list" id="stock-events-container">
                        <!-- Populated dynamically -->
                    </div>
                </div>
            </div>

            <!-- Sticky Bottom Trading Action Bar -->
            <div class="stock-chart-bottombar">
                <button type="button" class="btn btn-chart-sip" onclick="window.triggerSimulatedSip()">
                    SIP
                </button>
                <button type="button" class="btn btn-chart-sell" onclick="window.triggerChartTrade('SELL')">
                    Sell
                </button>
                <button type="button" class="btn btn-chart-buy" onclick="window.triggerChartTrade('BUY')">
                    Buy
                </button>
            </div>
        </div>
    </div>
</div>
