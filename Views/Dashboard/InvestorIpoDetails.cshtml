@model IPOInvestmentManagement.Models.CompanyIpoDetailsViewModel
@{
    ViewData["Title"] = "IPO Details";
    IPOInvestmentManagement.Models.IPO ipo = Model.Ipo;
    IPOInvestmentManagement.Models.Company? company = Model.Company;
    IPOInvestmentManagement.Models.IPOFinancial? financial = Model.Financial;
    IPOInvestmentManagement.Models.IPOAnalysis? analysis = Model.Analysis;
    IPOInvestmentManagement.Models.IPOListing? listing = Model.Listing;
}

<div class="admin-console">
    <header class="admin-topbar">
        <a class="admin-back-button" asp-controller="Dashboard" asp-action="Index">&#8592; Back to dashboard</a>
        <div class="admin-brand"><span></span> IPO <strong>INVEST</strong></div>
        <span class="admin-mode">INVESTOR IPO RESEARCH</span>
        <div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Investor")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div>
    </header>
    <main class="admin-main">
        <div class="admin-heading">
            <div><span class="admin-overline">IPO INFORMATION</span><h1>@ipo.IPO_name</h1><p>@(company?.Company_name ?? "Company") &middot; @(ipo.Status ?? "Published")</p></div>
        </div>
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">OFFER DETAILS</span><h2>Complete IPO overview</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Index" asp-fragment="published-ipos">Back to IPO market</a></div>
            <div class="admin-user-detail-grid">
                <div><span>IPO type</span><strong>@(ipo.IPO_type ?? "Not specified")</strong></div>
                <div><span>Application type</span><strong>@(ipo.Apply_type ?? "Not specified")</strong></div>
                <div><span>Price range</span><strong>₹@(ipo.Price_min?.ToString("N2") ?? "-") - ₹@(ipo.Price_max?.ToString("N2") ?? "-")</strong></div>
                <div><span>Lot size</span><strong>@(ipo.Lot_size?.ToString("N0") ?? "-") shares</strong></div>
                <div><span>Total shares</span><strong>@(ipo.Total_shares?.ToString("N0") ?? "-")</strong></div>
                <div><span>Issue size</span><strong>₹@(ipo.Issue_size?.ToString("N2") ?? "-")</strong></div>
                <div><span>Open date</span><strong>@ipo.Open_date.ToString("dd MMM yyyy")</strong></div>
                <div><span>Close date</span><strong>@ipo.Close_date.ToString("dd MMM yyyy")</strong></div>
                <div><span>Allotment date</span><strong>@(ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong></div>
                <div><span>Funds release date</span><strong>@(ipo.Funds_unblock_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong></div>
                <div><span>Listing date</span><strong>@(ipo.Listing_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong></div>
            </div>
            <p class="investor-ipo-description">@(ipo.Description ?? "No description provided for this IPO.")</p>
        </section>
        <!-- GREY MARKET PREMIUM (GMP) TRACKER (UNOFFICIAL) -->
        <section class="admin-user-details-card gmp-tracker-card" id="gmp-tracker">
            <div class="admin-section-head d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <span class="admin-overline text-warning font-monospace">UNOFFICIAL MARKET DATA &middot; GREY MARKET DESK</span>
                    <h2>Grey Market Premium (GMP) Tracking</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark border px-3 py-2 fw-bold">
                        ⚠️ UNOFFICIAL &middot; INDICATIVE ONLY
                    </span>
                </div>
            </div>

            <!-- Prominent Unofficial Disclaimer -->
            <div class="alert alert-warning gmp-disclaimer-box d-flex align-items-start gap-3 my-3 p-3 rounded-3">
                <span class="fs-4">⚠️</span>
                <div>
                    <strong class="d-block mb-1">Disclaimer: GMP is Unofficial and Non-Binding</strong>
                    <small class="d-block" style="line-height: 1.45;">
                        Grey Market Premium (GMP) is purely unofficial, unregulated, and peer-to-peer indicative sentiment outside recognized stock exchanges. 
                        It is <strong>NOT recognized, monitored, or endorsed by SEBI, NSE, or BSE</strong>. 
                        Estimated listing prices are purely theoretical projections based on grey market quotations and do not guarantee actual listing gains. Never make investment or bidding decisions solely based on unofficial GMP rates.
                    </small>
                </div>
            </div>

            <!-- GMP Metric Cards -->
            <div class="gmp-metrics-grid mb-4">
                <!-- Current GMP -->
                <div class="gmp-stat-card current-gmp">
                    <span class="gmp-stat-label">Current GMP <small class="text-muted">(Unofficial)</small></span>
                    <div class="gmp-stat-val text-success">
                        <span class="gmp-currency">₹</span>@(Model.CurrentGmp?.GMPPrice.ToString("N2") ?? "0.00")
                    </div>
                    <div class="gmp-stat-sub">
                        @if (Model.GmpChange > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success">
                                ▲ +₹@Model.GmpChange.ToString("N2") (+@Model.GmpChangePercentage%)
                            </span>
                        }
                        else if (Model.GmpChange < 0)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                ▼ -₹@Math.Abs(Model.GmpChange).ToString("N2") (@Model.GmpChangePercentage%)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">Flat (0.00)</span>
                        }
                        <span class="text-muted ms-1">vs prev quote</span>
                    </div>
                </div>

                <!-- Previous GMP -->
                <div class="gmp-stat-card">
                    <span class="gmp-stat-label">Previous GMP <small class="text-muted">(Last Recorded)</small></span>
                    <div class="gmp-stat-val text-secondary">
                        <span class="gmp-currency">₹</span>@(Model.PreviousGmp?.GMPPrice.ToString("N2") ?? Model.CurrentGmp?.GMPPrice.ToString("N2") ?? "-")
                    </div>
                    <div class="gmp-stat-sub text-muted">
                        Recorded on @(Model.PreviousGmp?.RecordedDate.ToString("dd MMM yyyy") ?? Model.CurrentGmp?.RecordedDate.ToString("dd MMM yyyy") ?? "N/A")
                    </div>
                </div>

                <!-- Estimated Listing Price -->
                <div class="gmp-stat-card highlight">
                    <span class="gmp-stat-label">Estimated Listing Price <small class="text-muted">(Unofficial)</small></span>
                    <div class="gmp-stat-val text-primary">
                        <span class="gmp-currency">₹</span>@Model.EstimatedListingPrice.ToString("N2")
                    </div>
                    <div class="gmp-stat-sub">
                        <span class="badge bg-primary-subtle text-primary border border-primary">
                            +@Model.EstimatedGainPercentage% Est. Listing Gain
                        </span>
                        <small class="text-muted ms-1">Base: ₹@(Model.Ipo.Price_max?.ToString("N2") ?? Model.Ipo.Price_min?.ToString("N2") ?? "-")</small>
                    </div>
                </div>


            </div>

            <!-- Historical Chart Container -->
            <div class="gmp-chart-container mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <h4 class="m-0 fs-6 fw-bold">GMP Historical Trend Line (Unofficial)</h4>
                        <small class="text-muted">Day-by-day unofficial premium movement ahead of listing</small>
                    </div>
                    <span class="badge bg-light text-dark border">
                        @Model.GmpHistory.Count recorded quote(s)
                    </span>
                </div>
                
                <div class="gmp-chart-viewport position-relative" style="height: 240px; background: #fafbfc; border: 1px solid #e1e4e8; border-radius: 8px; padding: 10px;">
                    <canvas id="investor-gmp-chart" style="width: 100%; height: 100%; display: block;"></canvas>
                    <div id="investor-gmp-tooltip" class="gmp-tooltip hidden"></div>
                </div>
            </div>

            <!-- Historical Log Table -->
            @if (Model.GmpHistory.Count > 0)
            {
                <div class="gmp-history-table-container">
                    <h4 class="fs-6 fw-bold mb-2">Historical GMP Movement Log</h4>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle border mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Recorded Date</th>
                                    <th>GMP (₹)</th>
                                    <th>Cap Price (₹)</th>
                                    <th>Est. Listing Price (₹)</th>
                                    <th>Est. Gain (%)</th>

                                    <th>Source</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.GmpHistory.OrderByDescending(r => r.RecordedDate).ThenByDescending(r => r.Gmp_id))
                                {
                                    <tr>
                                        <td><strong>@record.RecordedDate.ToString("dd MMM yyyy")</strong></td>
                                        <td><span class="badge bg-success-subtle text-success border border-success fw-bold">₹@record.GMPPrice.ToString("N2")</span></td>
                                        <td>₹@(Model.Ipo.Price_max?.ToString("N2") ?? Model.Ipo.Price_min?.ToString("N2") ?? "-")</td>
                                        <td><strong>₹@(record.EstimatedListingPrice?.ToString("N2") ?? ((Model.Ipo.Price_max ?? 0) + record.GMPPrice).ToString("N2"))</strong></td>
                                        <td>
                                            <span class="text-success fw-bold">+@(record.ExpectedListingGainPercentage?.ToString("N2") ?? "0.00")%</span>
                                        </td>

                                        <td><small class="text-muted">@(record.Source ?? "Unofficial Grey Market")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">COMPANY PROFILE</span><h2>@(company?.Company_name ?? "Company")</h2></div></div>
            <div class="admin-user-detail-grid">
                <div><span>Industry</span><strong>@(company?.Industry ?? "Not specified")</strong></div>
                <div><span>CIN</span><strong>@(company?.CIN ?? "Not specified")</strong></div>
                <div><span>Email</span><strong>@(company?.Email ?? "Not specified")</strong></div>
                <div><span>Phone</span><strong>@(company?.Phone ?? "Not specified")</strong></div>
                <div><span>Website</span><strong>@(company?.Website ?? "Not specified")</strong></div>
                <div><span>Address</span><strong>@(company?.Address ?? "Not specified")</strong></div>
            </div>
            <p class="investor-ipo-description">@(company?.Description ?? "No company description provided.")</p>
        </section>
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">FINANCIALS, ANALYSIS AND LISTING</span><h2>Market information</h2></div></div>
            <div class="admin-user-detail-grid">
                <div><span>Financial year</span><strong>@(financial?.Financial_year.ToString() ?? "Not available")</strong></div>
                <div><span>Revenue</span><strong>₹@(financial?.Revenue?.ToString("N2") ?? "-")</strong></div>
                <div><span>Profit</span><strong>₹@(financial?.Profit?.ToString("N2") ?? "-")</strong></div>
                <div><span>Net worth</span><strong>₹@(financial?.Net_worth?.ToString("N2") ?? "-")</strong></div>
                <div><span>ROE</span><strong>@(analysis?.ROE?.ToString("N2") ?? "-")%</strong></div>
                <div><span>Revenue growth</span><strong>@(analysis?.Revenue_growth?.ToString("N2") ?? "-")%</strong></div>
                <div><span>Profit growth</span><strong>@(analysis?.Profit_growth?.ToString("N2") ?? "-")%</strong></div>
                <div><span>Issue price</span><strong>₹@(listing?.Issue_price?.ToString("N2") ?? "-")</strong></div>
                <div><span>NSE listing price</span><strong>₹@(listing?.NSE_listing_price?.ToString("N2") ?? "-")</strong></div>
                <div><span>BSE listing price</span><strong>₹@(listing?.BSE_listing_price?.ToString("N2") ?? "-")</strong></div>
                <div><span>NSE closing price</span><strong>₹@(listing?.NSE_closing_price?.ToString("N2") ?? "-")</strong></div>
                <div><span>BSE closing price</span><strong>₹@(listing?.BSE_closing_price?.ToString("N2") ?? "-")</strong></div>
                <div><span>Listing gain</span><strong>@(listing?.Listing_gain_percentage?.ToString("N2") ?? "-")%</strong></div>
                <div><span>Listed date</span><strong>@(listing?.Listing_date?.ToString("dd MMM yyyy") ?? "Not listed")</strong></div>
            </div>
            <p class="investor-ipo-description">@(analysis?.Analysis_summary ?? "No analysis summary is available yet.")</p>
        </section>
    </main>
</div>

<script src="~/js/gmp-tracker.js" asp-append-version="true"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var gmpData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.GmpHistory.OrderBy(g => g.RecordedDate).ThenBy(g => g.Gmp_id).Select(g => new {
                date = g.RecordedDate.ToString("dd MMM"),
                fullDate = g.RecordedDate.ToString("dd MMM yyyy"),
                gmp = g.GMPPrice,
                estimatedPrice = g.EstimatedListingPrice ?? ((Model.Ipo.Price_max ?? Model.Ipo.Price_min ?? 0) + g.GMPPrice),
                gainPct = g.ExpectedListingGainPercentage ?? 0m
            })
        ));
        if (typeof window.initGmpHistoricalChart === "function") {
            window.initGmpHistoricalChart("investor-gmp-chart", "investor-gmp-tooltip", gmpData);
        }
    });
</script>
