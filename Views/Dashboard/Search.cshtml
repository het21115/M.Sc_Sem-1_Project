@model IPOInvestmentManagement.Models.AdminSearchViewModel
@{
    ViewData["Title"] = "Search System";
}

<div class="admin-console">
    <header class="admin-topbar"><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Admin")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">07 / SYSTEM SEARCH</span><h1>Search the platform</h1><p>Find users, IPO offerings, and company registrations from one workspace.</p></div><div class="admin-status"><i></i> Administrator access</div></div>
        <div class="admin-page-actions"><a class="admin-back-link" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a></div>
        <section class="admin-search-grid">
            <form class="admin-search-card" asp-controller="Dashboard" asp-action="Search" method="get"><div class="admin-section-head"><div><span class="admin-overline">SEARCH USERS</span><h2>Users</h2></div></div><label> Name, email, or phone<input name="UserQuery" value="@Model.UserQuery" placeholder="Search users" /></label><label>Role<select name="UserRole"><option value="">All roles</option><option selected="@(Model.UserRole == "Investor")">Investor</option><option selected="@(Model.UserRole == "Company")">Company</option><option selected="@(Model.UserRole == "Admin")">Admin</option></select></label><label>Status<select name="UserStatus"><option value="">All statuses</option><option selected="@(Model.UserStatus == "Active")">Active</option><option selected="@(Model.UserStatus == "Inactive")">Inactive</option></select></label><button class="btn btn-primary" type="submit">Search users</button><div class="admin-search-results">@foreach (var user in Model.Users) { <div><strong>@user.First_name @user.Last_name</strong><small>@user.Email &middot; @user.Phone &middot; @user.Role &middot; @(user.Is_active ? "Active" : "Inactive")</small><a asp-controller="Dashboard" asp-action="UserDetails" asp-route-userId="@user.User_id">View</a></div> }</div></form>
            <form class="admin-search-card" asp-controller="Dashboard" asp-action="Search" method="get"><div class="admin-section-head"><div><span class="admin-overline">SEARCH IPOS</span><h2>IPO offerings</h2></div></div><label>IPO name<input name="IpoQuery" value="@Model.IpoQuery" placeholder="Search IPO name" /></label><label>Company<input name="IpoCompanyQuery" value="@Model.IpoCompanyQuery" placeholder="Search company name" /></label><label>Status<select name="IpoStatus"><option value="">All statuses</option>@foreach (var status in new[] { "Pending", "Approved", "Open", "Closed", "Listed", "Rejected", "Cancelled" }) { <option selected="@(Model.IpoStatus == status)">@status</option> }</select></label><label>Date<input type="date" name="IpoDate" value="@(Model.IpoDate?.ToString("yyyy-MM-dd"))" /></label><label>Category / type<input name="IpoCategory" value="@Model.IpoCategory" placeholder="IPO type" /></label><button class="btn btn-primary" type="submit">Search IPOs</button><div class="admin-search-results">@foreach (var item in Model.Ipos) { <div><strong>@item.Ipo.IPO_name</strong><small>@item.CompanyName &middot; @item.Ipo.Status &middot; @item.Ipo.Open_date.ToString("dd MMM yyyy")</small><a asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@item.Ipo.IPO_id">View</a></div> }</div></form>
            <form class="admin-search-card" asp-controller="Dashboard" asp-action="Search" method="get"><div class="admin-section-head"><div><span class="admin-overline">SEARCH COMPANIES</span><h2>Companies</h2></div></div><label>Company name<input name="CompanyQuery" value="@Model.CompanyQuery" placeholder="Search company name" /></label><label>CIN<input name="CompanyCin" value="@Model.CompanyCin" placeholder="Search CIN" /></label><label>Industry<input name="CompanyIndustry" value="@Model.CompanyIndustry" placeholder="Search industry" /></label><label>Approval status<select name="CompanyStatus"><option value="">All statuses</option><option selected="@(Model.CompanyStatus == "Pending")">Pending</option><option selected="@(Model.CompanyStatus == "Approved")">Approved</option><option selected="@(Model.CompanyStatus == "Denied")">Denied</option></select></label><button class="btn btn-primary" type="submit">Search companies</button><div class="admin-search-results">@foreach (var company in Model.Companies) { <div><strong>@company.Company_name</strong><small>@company.CIN &middot; @company.Industry &middot; @company.Approval_status</small><a asp-controller="Dashboard" asp-action="CompanyDetails" asp-route-companyId="@company.Company_id">View</a></div> }</div></form>
        </section>
    </main>
</div>
