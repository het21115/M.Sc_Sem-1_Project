@model IPOInvestmentManagement.Models.AdminApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
    var application = Model.Application;
    var ipo = Model.Ipo;
    var allotment = Model.Allotment;
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Dashboard")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Admin")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">APPLICATION DETAILS</span><h1>Application #@Model.Application.Application_id</h1><p>Review the investor's application and submitted order details.</p></div><div class="admin-status"><i></i> Administrator access</div></div>
        @if (TempData["AdminMessage"] is string adminMessage) { <div class="alert alert-info mt-3" role="alert">@adminMessage</div> }
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">SUBMISSION SUMMARY</span><h2>@(Model.Ipo?.IPO_name ?? "IPO")</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Applications">Back to applications</a></div>
            <div class="admin-user-detail-grid">
                <div><span>Investor</span><strong>@($"{Model.Investor?.First_name} {Model.Investor?.Last_name}".Trim())</strong></div>
                <div><span>Email</span><strong>@(Model.Investor?.Email ?? "Not available")</strong></div>
                <div><span>Phone</span><strong>@(Model.Investor?.Phone ?? "Not available")</strong></div>
                <div><span>IPO</span><strong>@(Model.Ipo?.IPO_name ?? "Not available")</strong></div>
                <div><span>Application number</span><strong>@(Model.Application.Application_number ?? $"#{Model.Application.Application_id}")</strong></div>
                <div><span>Status</span><strong>@(Model.Application.Status ?? "Pending")</strong></div>
                <div><span>Application date</span><strong>@Model.Application.Application_date.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                <div><span>Applied lots</span><strong>@Model.Application.Applied_lots.ToString("N0")</strong></div>
                <div><span>Applied shares</span><strong>@Model.Application.Applied_shares.ToString("N0")</strong></div>
                <div><span>Bid price</span><strong>₹@((Model.Application.Bid_price ?? 0m).ToString("N2"))</strong></div>
                <div><span>Application amount</span><strong>₹@((Model.Application.Application_amount ?? 0m).ToString("N2"))</strong></div>
                <div><span>Demat account</span><strong>@(Model.Application.Demat_account_number ?? "Not recorded")</strong></div>
                <div><span>UPI ID</span><strong>@(Model.Application.Upi_id ?? "Not recorded")</strong></div>
                <div><span>Payment status</span><strong>@(Model.Application.Payment_status ?? "Not recorded")</strong></div>
                @if (application.Cancellation_date.HasValue)
                {
                    <div><span>Cancellation date</span><strong>@application.Cancellation_date.Value.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                    <div><span>Cancellation admin ID</span><strong>@(application.Cancellation_admin_id?.ToString() ?? "Not recorded")</strong></div>
                    <div><span>Cancellation reason</span><strong>@(application.Cancellation_reason ?? "Not recorded")</strong></div>
                }
                @if (allotment is not null)
                {
                    <div><span>Allotment status</span><strong>@allotment.Status</strong></div>
                    <div><span>Allotted lots</span><strong>@allotment.Allotted_lots.ToString("N0")</strong></div>
                    <div><span>Allotted shares</span><strong>@allotment.Allotted_shares.ToString("N0")</strong></div>
                    <div><span>Allotment price</span><strong>₹@allotment.Allotment_price.ToString("N2")</strong></div>
                }
            </div>
            <div class="company-request-actions admin-detail-actions">
                @if (allotment is null &&
                    !string.Equals(application.Status, "Rejected", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Allotted", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Partially Allotted", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-controller="Dashboard" asp-action="CancelApplication" method="post" class="admin-allotment-form" onsubmit="return confirm('Cancel this application? This action cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApplicationId" value="@application.Application_id" />
                        <label>Cancellation reason<textarea name="Reason" maxlength="500" minlength="5" required placeholder="Enter the reason for cancellation"></textarea></label>
                        <button class="btn btn-outline-danger" type="submit">Cancel application</button>
                    </form>
                }
                @if (allotment is null && DateTime.UtcNow.AddHours(5.5).Date > ipo.Close_date.Date && !string.Equals(application.Status, "Rejected", StringComparison.OrdinalIgnoreCase) && !string.Equals(application.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-controller="Dashboard" asp-action="ProcessAllotment" method="post" class="admin-allotment-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="applicationId" value="@application.Application_id" />
                        <label>Allotted lots<input type="number" name="allottedLots" min="0" max="@application.Applied_lots" value="@application.Applied_lots" required /></label>
                        <label>Allotted shares<input type="number" name="allottedShares" min="0" max="@application.Applied_shares" value="@application.Applied_shares" required /></label>
                        <label>Allotment price <small>(optional)</small><input type="number" name="allotmentPrice" min="0" step="0.01" placeholder="Application price" /></label>
                        <button class="btn btn-primary" type="submit">Process allotment</button>
                    </form>
                }
                else if (allotment is null && ipo.Close_date.Date >= DateTime.UtcNow.AddHours(5.5).Date && !string.Equals(application.Status, "Rejected", StringComparison.OrdinalIgnoreCase) && !string.Equals(application.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="admin-muted">Allotment can be processed after the IPO closes on @ipo.Close_date.ToString("dd MMM yyyy").</p>
                }
            </div>
        </section>
    </main>
</div>
