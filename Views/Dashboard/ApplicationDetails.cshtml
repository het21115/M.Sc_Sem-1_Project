@model IPOInvestmentManagement.Models.AdminApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
    var application = Model.Application;
    var ipo = Model.Ipo;
    var allotment = Model.Allotment;
    var upiId = string.IsNullOrWhiteSpace(application.Upi_id) ? Model.Investor?.UpiId : application.Upi_id;
    int lotSize = ipo?.Lot_size ?? 1;
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Dashboard")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Admin")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">APPLICATION DETAILS</span><h1>Application #@Model.Application.Application_id</h1><p>Review the investor's application and submitted order details.</p></div><div class="admin-status"><i></i> Administrator access</div></div>
        @if (TempData["AdminMessage"] is string adminMessage) { <div class="alert alert-info mt-3" role="alert">@adminMessage</div> }
        <section class="admin-user-details-card">
            <div class="admin-section-head"><div><span class="admin-overline">SUBMISSION SUMMARY</span><h2>@(Model.Ipo?.IPO_name ?? "IPO")</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Applications">Back to applications</a></div>
            <div class="admin-user-detail-grid">
                <div><span>Investor</span><strong>@($"{Model.Investor?.First_name} {Model.Investor?.Last_name}".Trim())</strong></div>
                <div><span>Email</span><strong>@(Model.Investor?.Email ?? "Not available")</strong></div>
                <div><span>Phone</span><strong>@(Model.Investor?.Phone ?? "Not available")</strong></div>
                <div><span>IPO</span><strong>@(Model.Ipo?.IPO_name ?? "Not available")</strong></div>
                <div><span>Application number</span><strong>@(Model.Application.Application_number ?? $"#{Model.Application.Application_id}")</strong></div>
                <div><span>Status</span><strong>@(Model.Application.Status ?? "Pending")</strong></div>
                <div><span>Application date</span><strong>@Model.Application.Application_date.AddHours(5.5).ToString("dd MMM yyyy, hh:mm tt") IST</strong></div>
                <div><span>Applied lots</span><strong>@Model.Application.Applied_lots.ToString("N0")</strong></div>
                <div><span>Applied shares</span><strong>@Model.Application.Applied_shares.ToString("N0")</strong></div>
                <div><span>Bid price</span><strong>₹@((Model.Application.Bid_price ?? 0m).ToString("N2"))</strong></div>
                <div><span>Application amount</span><strong>₹@((Model.Application.Application_amount ?? 0m).ToString("N2"))</strong></div>
                <div><span>UPI ID</span><strong>@(upiId ?? "Not recorded")</strong></div>
                <div><span>Payment status</span><strong>@(Model.Application.Payment_status ?? "Not recorded")</strong></div>
                <div>
                    <span>Payment workflow</span>
                    <strong>
                        @if (Model.Payment?.IsSimulated ?? Model.Application.Is_simulated_payment ?? true)
                        {
                            <span class="badge bg-warning text-dark">🧪 Simulated ASBA Mandate</span>
                        }
                        else
                        {
                            <span class="badge bg-success">💳 Genuine Gateway</span>
                        }
                    </strong>
                </div>
                <div><span>Razorpay order ID</span><strong class="font-monospace small">@(Model.Application.Razorpay_order_id ?? "Not recorded")</strong></div>
                <div><span>Transaction ID</span><strong class="font-monospace text-primary">@(Model.Application.Razorpay_payment_id ?? Model.Application.Payment_reference ?? "Not recorded")</strong></div>
                <div>
                    <span>Payment receipt</span>
                    <strong>
                        @if (Model.Payment != null)
                        {
                            <a class="btn btn-sm btn-outline-primary py-0 px-2 font-monospace" asp-controller="Dashboard" asp-action="PaymentReceipt" asp-route-paymentRecordId="@Model.Payment.PaymentRecordId">
                                📄 @(Model.Payment.ReceiptNumber ?? "View Receipt")
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No receipt generated</span>
                        }
                    </strong>
                </div>
                <div><span>Payment amount</span><strong>₹@((Model.Application.Payment_amount ?? 0m).ToString("N2"))</strong></div>
                <div><span>Refund / unblock</span><strong>@(Model.Payment?.RefundStatus ?? "Not applicable")</strong></div>
                @if (Model.Payment?.UnblockedAmount > 0)
                {
                    <div><span>Amount to unblock</span><strong>₹@Model.Payment.UnblockedAmount.ToString("N2")</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Payment?.RefundReferenceId))
                {
                    <div><span>Refund Ref ID</span><strong class="font-monospace">@Model.Payment.RefundReferenceId</strong></div>
                }
                @if (application.Cancellation_date.HasValue)
                {
                    <div><span>Cancellation date</span><strong>@application.Cancellation_date.Value.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                    <div><span>Cancellation admin ID</span><strong>@(application.Cancellation_admin_id?.ToString() ?? "Not recorded")</strong></div>
                    <div><span>Cancellation reason</span><strong>@(application.Cancellation_reason ?? "Not recorded")</strong></div>
                }
                @if (allotment is not null)
                {
                    <div><span>Allotment status</span><strong class="@(allotment.Status == "Allotted" ? "text-success" : allotment.Status == "Partially Allotted" ? "text-primary" : "text-danger")">@allotment.Status</strong></div>
                    <div><span>Allotted lots</span><strong>@allotment.Allotted_lots.ToString("N0")</strong></div>
                    <div><span>Allotted shares</span><strong>@allotment.Allotted_shares.ToString("N0")</strong></div>
                    <div><span>Allotment price</span><strong>₹@allotment.Allotment_price.ToString("N2")</strong></div>
                    <div><span>Debited amount</span><strong>₹@allotment.Debited_amount.ToString("N2")</strong></div>
                    <div><span>Unblocked / refund</span><strong>₹@allotment.Unblocked_amount.ToString("N2")</strong></div>
                    <div><span>CAN / Advice Ref</span><strong class="font-monospace text-primary">@(allotment.Advice_number ?? "Generated")</strong></div>
                }
            </div>
            @if (allotment is not null)
            {
                <div class="d-flex flex-wrap gap-2 mb-3 mt-3">
                    <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="AllotmentAdvice" asp-route-applicationId="@application.Application_id">
                        &#128196; View Official Allotment Advice (CAN)
                    </a>
                    <a class="btn btn-outline-success" asp-controller="Dashboard" asp-action="DownloadAllotmentAdvicePdf" asp-route-applicationId="@application.Application_id" target="_blank">
                        &#128190; Download Allotment Advice PDF
                    </a>
                </div>

                @if (ipo.Allotment_finalized)
                {
                    <div class="alert alert-secondary d-flex align-items-center justify-content-between p-3 mt-3 border">
                        <div>
                            <strong>&#128274; Finalized Allotment (Locked)</strong>
                            <p class="mb-0 small text-muted">Allotment for this IPO was finalized and locked on @(ipo.Allotment_finalized_at?.ToString("dd MMM yyyy, hh:mm tt") ?? "record"). Standard editing is disabled.</p>
                        </div>
                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="var box = document.getElementById('authorized-correction-box'); box.style.display = box.style.display === 'none' ? 'block' : 'none';">
                            &#9888; Authorized Correction Process
                        </button>
                    </div>

                    <div id="authorized-correction-box" class="p-3 my-3 border border-warning rounded bg-light" style="display: none;">
                        <h6 class="text-danger fw-bold">&#9888; Authorized Allotment Correction Process</h6>
                        <p class="small text-muted mb-3">SEBI Auditable Action: Adjusting a finalized allotment requires an auditable justification, verifies lot size and applied shares invariants, recalculates refunds, synchronizes demat holdings, and records an official Audit Log.</p>
                        <form asp-controller="Dashboard" asp-action="AuthorizeAllotmentCorrection" method="post" onsubmit="return confirm('WARNING: You are about to execute an authorized correction on a finalized allotment. This action will adjust demat shares and bank unblocks. Are you sure?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ApplicationId" value="@application.Application_id" />
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Corrected Lots (0 to @application.Applied_lots):</label>
                                    <input type="number" name="CorrectedLots" class="form-control form-control-sm" min="0" max="@application.Applied_lots" value="@allotment.Allotted_lots" required />
                                    <span class="small text-muted">Allotted shares must equal Lots &times; @lotSize</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Allotment Price (₹):</label>
                                    <input type="number" name="CorrectedPrice" class="form-control form-control-sm" step="0.01" min="@(ipo.Price_min ?? 0)" max="@(ipo.Price_max ?? decimal.MaxValue)" value="@allotment.Allotment_price.ToString("F2")" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-danger">Mandatory Auditable Justification (Min 10 characters):</label>
                                <textarea name="CorrectionReason" class="form-control form-control-sm" rows="2" placeholder="State regulatory, audit, or technical discrepancy reason for this correction..." required minlength="10"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Authorization Confirmation Passcode:</label>
                                <input type="text" name="AuthorizationPasscode" class="form-control form-control-sm" placeholder="Type CONFIRM-CORRECTION" required />
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm">Authorize & Commit Correction</button>
                        </form>
                    </div>
                }
            }
            @if (Model.Payment?.UnblockedAmount > 0 && Model.Payment.RefundStatus != "Completed")
            {
                <form asp-controller="Dashboard" asp-action="SimulateUnblock" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="applicationId" value="@application.Application_id" />
                    <button class="btn btn-outline-warning" type="submit">Simulate refund / unblock</button>
                </form>
            }
            <div class="company-request-actions admin-detail-actions">
                @if (allotment is null &&
                    DateTime.UtcNow.AddHours(5.5).Date <= ipo.Close_date.Date &&
                    string.Equals(application.Status, "Submitted", StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(application.Payment_status, "Verified", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Rejected", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Allotted", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(application.Status, "Partially Allotted", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-controller="Dashboard" asp-action="CancelApplication" method="post" class="admin-allotment-form admin-cancellation-form" onsubmit="return confirm('Cancel this application? This action cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApplicationId" value="@application.Application_id" />
                        <label for="cancellation-reason">Cancellation reason<textarea id="cancellation-reason" name="Reason" maxlength="500" minlength="5" required placeholder="Enter the reason for cancellation"></textarea></label>
                        <button class="btn btn-outline-danger" type="submit">Cancel application</button>
                    </form>
                }
                @{
                    var todayIst = DateTime.UtcNow.AddHours(5.5).Date;
                    bool isIpoCancelledOrRejected = string.Equals(ipo.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) || string.Equals(ipo.Status, "Rejected", StringComparison.OrdinalIgnoreCase);
                    bool isClosed = todayIst > ipo.Close_date.Date || string.Equals(ipo.Status, "Closed", StringComparison.OrdinalIgnoreCase) || string.Equals(ipo.Status, "Listed", StringComparison.OrdinalIgnoreCase);
                    bool hasAllotmentDate = ipo.Allotment_date.HasValue;
                    bool isAllotmentDateReached = hasAllotmentDate && todayIst >= ipo.Allotment_date!.Value.Date;
                    bool canProcessAllotment = isClosed && isAllotmentDateReached && !ipo.Allotment_finalized && !isIpoCancelledOrRejected;
                    lotSize = ipo?.Lot_size ?? lotSize;
                    decimal defaultPrice = (application.Application_amount ?? 0m) / (application.Applied_shares > 0 ? application.Applied_shares : 1);
                    if (defaultPrice <= 0m) { defaultPrice = ipo.Price_max ?? ipo.Price_min ?? 0m; }
                }
                @if (allotment is null && canProcessAllotment && string.Equals(application.Status, "Submitted", StringComparison.OrdinalIgnoreCase) && string.Equals(application.Payment_status, "Verified", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-controller="Dashboard" asp-action="PreviewAllotment" method="get" class="admin-allotment-form p-3 border rounded bg-light">
                        <div class="fw-bold mb-2 text-navy">&#9881; Process Allotment (Automatic Calculation Enabled)</div>
                        <input type="hidden" name="applicationId" value="@application.Application_id" />
                        <label>
                            Allotted lots (0 to @application.Applied_lots):
                            <input type="number" id="manual-allotted-lots" name="allottedLots" min="0" max="@application.Applied_lots" value="@application.Applied_lots" required />
                        </label>
                        <label>
                            Allotted shares (Auto-calculated: Lots &times; @lotSize):
                            <input type="number" id="manual-allotted-shares" name="allottedShares" min="0" max="@application.Applied_shares" value="@application.Applied_shares" required />
                        </label>
                        <label>
                            Allotment price:
                            <input type="number" id="manual-allotment-price" name="allotmentPrice" min="@(ipo.Price_min ?? 0)" max="@(ipo.Price_max ?? decimal.MaxValue)" step="0.01" value="@defaultPrice.ToString("F2")" />
                        </label>
                        
                        <!-- Real-time calculation summary -->
                        <div class="p-2 my-2 bg-white border rounded small">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Calculated Allotment Status:</span>
                                <strong id="calc-status" class="text-success">Full Allotment</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Amount to Debit:</span>
                                <strong id="calc-debited">₹@((application.Applied_shares * defaultPrice).ToString("N2"))</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Amount to Unblock / Refund:</span>
                                <strong id="calc-unblocked" class="text-warning">₹0.00</strong>
                            </div>
                        </div>

                        <button class="btn btn-primary mt-2" type="submit">Preview Allotment</button>
                    </form>

                    <script>
                        (function() {
                            var lotSize = @lotSize;
                            var maxLots = @application.Applied_lots;
                            var blockedAmount = @(application.Application_amount ?? (application.Applied_shares * defaultPrice));
                            var lotsInput = document.getElementById('manual-allotted-lots');
                            var sharesInput = document.getElementById('manual-allotted-shares');
                            var priceInput = document.getElementById('manual-allotment-price');
                            var statusEl = document.getElementById('calc-status');
                            var debitedEl = document.getElementById('calc-debited');
                            var unblockedEl = document.getElementById('calc-unblocked');

                            function updateCalculations() {
                                var lots = parseInt(lotsInput.value, 10);
                                if (isNaN(lots) || lots < 0) lots = 0;
                                if (lots > maxLots) lots = maxLots;
                                
                                // Auto-calculate shares from lots
                                var shares = lots * lotSize;
                                sharesInput.value = shares;

                                var price = parseFloat(priceInput.value);
                                if (isNaN(price) || price < 0) price = 0;

                                var debited = shares * price;
                                var unblocked = Math.max(0, blockedAmount - debited);

                                if (lots === 0) {
                                    statusEl.textContent = "Not Allotted (100% Refund)";
                                    statusEl.className = "text-danger";
                                } else if (lots === maxLots) {
                                    statusEl.textContent = "Full Allotment";
                                    statusEl.className = "text-success";
                                } else {
                                    statusEl.textContent = "Partial Allotment (" + lots + "/" + maxLots + " lots)";
                                    statusEl.className = "text-primary";
                                }

                                debitedEl.textContent = "₹" + debited.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                unblockedEl.textContent = "₹" + unblocked.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            }

                            if (lotsInput && sharesInput && priceInput) {
                                lotsInput.addEventListener('input', updateCalculations);
                                priceInput.addEventListener('input', updateCalculations);
                            }
                        })();
                    </script>
                }
                else if (allotment is null && !canProcessAllotment && !string.Equals(application.Status, "Rejected", StringComparison.OrdinalIgnoreCase) && !string.Equals(application.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="admin-muted admin-allotment-note">
                        @if (isIpoCancelledOrRejected)
                        {
                            <text>Allotment cannot be processed because this IPO issue has been @(ipo?.Status?.ToLowerInvariant() ?? "closed").</text>
                        }
                        else if (ipo.Allotment_finalized)
                        {
                            <text>Allotment for this IPO has been finalized and locked. Normal allotment processing is disabled.</text>
                        }
                        else if (!isClosed)
                        {
                            <text>Allotment can be processed only after the IPO bidding window closes (Closing date: @ipo.Close_date.ToString("dd MMM yyyy")).</text>
                        }
                        else if (!hasAllotmentDate)
                        {
                            <text>Allotment can be processed once an allotment date is configured on the IPO.</text>
                        }
                        else
                        {
                            <text>Allotment can be processed on or after the configured allotment date: @ipo.Allotment_date!.Value.ToString("dd MMM yyyy").</text>
                        }
                    </p>
                }
            </div>
        </section>
    </main>
</div>
