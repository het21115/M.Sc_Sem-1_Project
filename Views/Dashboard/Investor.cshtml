        <section class="watchlist-panel" id="watchlist"><div class="terminal-section-head"><div><span class="terminal-overline">03 / PERSONAL WATCHLIST</span><h2>My Watchlist</h2></div><span class="investor-library-note">@Model.WatchlistDetails.Count saved</span></div>@if (Model.WatchlistDetails.Count == 0) { <div class="terminal-empty">Your watchlist is empty. Use "Add to watchlist" on any IPO below.</div> } else { <div class="watchlist-items">@foreach (var detail in Model.WatchlistDetails) { <div class="watchlist-item"><a class="watchlist-ipo-link" href="#ipo-record-@detail.Ipo.IPO_id"><strong>@detail.Ipo.IPO_name</strong><small>@Model.CompanyNames.GetValueOrDefault(detail.Ipo.Company_id, "Company") &middot; @Model.MarketStatuses.GetValueOrDefault(detail.Ipo.IPO_id, "Published")</small></a><span>₹@((detail.Listing?.NSE_closing_price ?? detail.Listing?.NSE_listing_price ?? detail.Ipo.Price_max)?.ToString("N2") ?? "-")</span><form asp-controller="Dashboard" asp-action="ToggleWatchlist" method="post">@Html.AntiForgeryToken()<input type="hidden" name="ipoId" value="@detail.Ipo.IPO_id" /><button type="submit" class="watchlist-remove">Remove</button></form></div> }</div> }</section>
        <section class="investor-status-summary"><div class="terminal-section-head"><div><span class="terminal-overline">02 / PUBLISHED IPO STATUS</span><h2>All published IPO status</h2></div></div><div class="investor-status-counts"><a href="#search-ipo-modal" data-ipo-status="Open" data-bs-toggle="modal" data-bs-target="#search-ipo-modal"><span>OPEN</span><strong id="count-open-ipos">@Model.MarketIpos.Count(ipo => Model.MarketStatuses.GetValueOrDefault(ipo.IPO_id, "Upcoming") == "Open")</strong><small>Accepting applications</small></a><a href="#search-ipo-modal" data-ipo-status="Upcoming" data-bs-toggle="modal" data-bs-target="#search-ipo-modal"><span>UPCOMING</span><strong id="count-upcoming-ipos">@Model.MarketIpos.Count(ipo => Model.MarketStatuses.GetValueOrDefault(ipo.IPO_id, "Upcoming") == "Upcoming")</strong><small>Opening soon</small></a><a href="#search-ipo-modal" data-ipo-status="Closed" data-bs-toggle="modal" data-bs-target="#search-ipo-modal"><span>CLOSED</span><strong id="count-closed-ipos">@Model.MarketIpos.Count(ipo => Model.MarketStatuses.GetValueOrDefault(ipo.IPO_id, "Upcoming") == "Closed")</strong><small>Application window ended</small></a><a href="#search-ipo-modal" data-ipo-status="Listed" data-bs-toggle="modal" data-bs-target="#search-ipo-modal"><span>LISTED</span><strong id="count-listed-ipos">@Model.MarketIpos.Count(ipo => Model.MarketStatuses.GetValueOrDefault(ipo.IPO_id, "Upcoming") == "Listed")</strong><small>Trading on the market</small></a></div></section>
        <section class="investor-calendar" id="ipo-calendar"><div class="terminal-section-head"><div><span class="terminal-overline">03 / IPO CALENDAR</span><h2>IPO milestones</h2><p>Track opening, closing, allotment, and listing dates.</p></div><span class="investor-library-note">@Model.CalendarIpoDetails.Count IPOs this month</span></div><form class="investor-calendar-filters" asp-controller="Dashboard" asp-action="Index" method="get" asp-fragment="ipo-calendar"><input type="hidden" name="marketStatus" value="@Model.MarketStatus" /><input type="hidden" name="marketIpoType" value="@Model.MarketIpoType" /><input type="hidden" name="marketIpoName" value="@Model.MarketIpoName" /><input type="hidden" name="marketCompany" value="@Model.MarketCompany" /><label>Month<select name="calendarMonth">@for (int month = 1; month <= 12; month++) { <option value="@month" selected="@(month == Model.CalendarMonth ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option> }</select></label><label>Year<select name="calendarYear">@for (int year = DateTime.Now.Year - 1; year <= DateTime.Now.Year + 2; year++) { <option value="@year" selected="@(year == Model.CalendarYear ? "selected" : null)">@year</option> }</select></label><button class="btn investor-market-submit" type="submit">Show dates</button></form>@if (Model.CalendarIpoDetails.Count == 0) { <div class="terminal-empty">No IPO milestones are scheduled for this month.</div> } else { <div class="investor-calendar-list">@foreach (var detail in Model.CalendarIpoDetails) { bool isWatched = Model.WatchlistDetails.Any(item => item.Ipo.IPO_id == detail.Ipo.IPO_id); <article class="investor-calendar-card"><div class="investor-calendar-card-head"><div><strong>@detail.Ipo.IPO_name</strong><small>@Model.CompanyNames.GetValueOrDefault(detail.Ipo.Company_id, "Company")</small></div><form asp-controller="Dashboard" asp-action="ToggleWatchlist" method="post">@Html.AntiForgeryToken()<input type="hidden" name="ipoId" value="@detail.Ipo.IPO_id" /><button type="submit" class="watchlist-action">@(isWatched ? "Reminder set" : "Set reminder")</button></form></div><div class="investor-calendar-dates"><span><small>Opening</small><b>@detail.Ipo.Open_date.ToString("dd MMM yyyy")</b></span><span><small>Closing</small><b>@detail.Ipo.Close_date.ToString("dd MMM yyyy")</b></span><span><small>Allotment</small><b>@(detail.Ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "Not announced")</b></span><span><small>Listing</small><b>@(detail.Ipo.Listing_date?.ToString("dd MMM yyyy") ?? "Not announced")</b></span></div></article> }</div> }</section>
        <section class="investor-comparison" id="ipo-comparison"><div class="terminal-section-head"><div><span class="terminal-overline">04 / IPO COMPARISON</span><h2>Compare opportunities</h2><p>Select two or three IPOs to compare their fundamentals and market performance.</p></div></div><form class="investor-comparison-picker" asp-controller="Dashboard" asp-action="Index" method="get" asp-fragment="ipo-comparison"><div class="investor-comparison-options">@foreach (var ipo in Model.MarketIpos) { <label><input type="checkbox" name="compareIpoIds" value="@ipo.IPO_id" checked="@(Model.ComparisonIpoIds.Contains(ipo.IPO_id))" /> <span>@ipo.IPO_name<small>@Model.CompanyNames.GetValueOrDefault(ipo.Company_id, "Company")</small></span></label> }</div><button class="btn investor-market-submit" type="submit">Compare selected IPOs</button></form>@if (Model.ComparisonIpoDetails.Count < 2) { <div class="terminal-empty">Select at least two IPOs to view a comparison.</div> } else { <div class="investor-comparison-table"><div class="investor-comparison-row investor-comparison-heading"><strong>Metric</strong>@foreach (var detail in Model.ComparisonIpoDetails) { <strong>@detail.Ipo.IPO_name</strong> }</div><div class="investor-comparison-row"><span>Price band</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>₹@(detail.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(detail.Ipo.Price_max?.ToString("N2") ?? "-")</span> }</div><div class="investor-comparison-row"><span>Issue size</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>₹@(detail.Ipo.Issue_size?.ToString("N2") ?? "-")</span> }</div><div class="investor-comparison-row"><span>Revenue</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>₹@(detail.Financial?.Revenue?.ToString("N2") ?? "-")</span> }</div><div class="investor-comparison-row"><span>Profit</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>₹@(detail.Financial?.Profit?.ToString("N2") ?? "-")</span> }</div><div class="investor-comparison-row"><span>ROE</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>@(detail.ComparisonRoe?.ToString("N2") ?? "Not available")@(detail.ComparisonRoe.HasValue ? "%" : "")</span> }</div><div class="investor-comparison-row"><span>Revenue growth</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>@(detail.ComparisonRevenueGrowth?.ToString("N2") ?? "Not available")@(detail.ComparisonRevenueGrowth.HasValue ? "%" : "")</span> }</div><div class="investor-comparison-row"><span>Profit growth</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>@(detail.ComparisonProfitGrowth?.ToString("N2") ?? "Not available")@(detail.ComparisonProfitGrowth.HasValue ? "%" : "")</span> }</div><div class="investor-comparison-row"><span>Listing performance</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>@(detail.ComparisonListingPerformance?.ToString("N2") ?? "Not listed")@(detail.ComparisonListingPerformance.HasValue ? "%" : "")</span> }</div><div class="investor-comparison-row"><span>Subscription</span>@foreach (var detail in Model.ComparisonIpoDetails) { <span>@Model.ComparisonSubscriptionMultiples.GetValueOrDefault(detail.Ipo.IPO_id).ToString("N2")x</span> }</div></div> }</section>
        <section class="investor-ipo-library" id="published-ipos">
            <div class="terminal-section-head">
                <div>
                    <span class="terminal-overline">05 / PUBLISHED MARKET DATA</span>
                    <h2>Published IPO information</h2>
                </div>
                <span class="investor-library-note" id="published-ipos-counter">
                    @(Model.PublishedIpoDetails.Count > 3 ? $"Showing 3 of {Model.PublishedIpoDetails.Count} offering(s)" : (Model.PublishedIpoDetails.Count == 0 ? "Admin-approved offerings" : $"{Model.PublishedIpoDetails.Count} offering(s)"))
                </span>
