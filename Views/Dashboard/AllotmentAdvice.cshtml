@model IPOInvestmentManagement.Models.AllotmentAdviceViewModel
@{
    ViewData["Title"] = $"Allotment Advice - {Model.AdviceNumber}";
    string role = Context.Session.GetString("UserRole") ?? "Investor";
    bool isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4">
    <!-- Action Toolbar (hidden on print) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 d-print-none gap-2">
        <div>
            @if (isAdmin)
            {
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="ApplicationDetails" asp-route-applicationId="@Model.ApplicationId">
                    &#8592; Back to Application Details
                </a>
            }
            else
            {
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="InvestorApplicationDetails" asp-route-applicationId="@Model.ApplicationId">
                    &#8592; Back to My Application
                </a>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark" onclick="window.print()">
                &#128438; Print Advice
            </button>
            <a class="btn btn-success" asp-controller="Dashboard" asp-action="DownloadAllotmentAdvicePdf" asp-route-applicationId="@Model.ApplicationId" target="_blank">
                &#128190; Download Official PDF Advice
            </a>
        </div>
    </div>

    <!-- Official Allotment Advice / CAN Shell -->
    <div class="card shadow border-0 p-4 p-md-5" style="border-radius: 14px; background: #ffffff; max-width: 900px; margin: 0 auto; border: 1px solid #dce4ec !important;">
        <!-- Header -->
        <div class="border-bottom pb-4 mb-4">
            <div class="row align-items-center">
                <div class="col-sm-8">
                    <span class="badge bg-dark text-uppercase px-3 py-1 mb-2" style="letter-spacing: 1px; font-size: 0.75rem;">SEBI Form CAN</span>
                    <h2 class="h4 fw-bold text-navy mb-1">CONFIRMATION OF ALLOCATION NOTE (CAN)</h2>
                    <div class="text-muted small">Official Allotment Advice &amp; Mandate Settlement Statement</div>
                </div>
                <div class="col-sm-4 text-sm-end mt-3 mt-sm-0">
                    <div class="p-2 rounded bg-light border text-center text-sm-end">
                        <small class="text-muted d-block" style="font-size: 0.7rem;">ADVICE / CAN REFERENCE</small>
                        <strong class="font-monospace text-primary fs-6">@Model.AdviceNumber</strong>
                        <small class="text-muted d-block" style="font-size: 0.68rem;">Date: @Model.AllotmentDate.ToString("dd MMM yyyy")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Status Banner -->
        @if (Model.Status == "Allotted")
        {
            <div class="alert alert-success border-success d-flex align-items-center justify-content-between p-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3">&#10004;</span>
                    <div>
                        <strong class="fs-6 d-block text-success">FULL ALLOTMENT CONFIRMED</strong>
                        <span class="small text-muted">You have been allotted @Model.AllottedShares.ToString("N0") equity shares (@Model.AllottedLots lot(s)). Equity shares are credited directly to your designated Demat account.</span>
                    </div>
                </div>
                <span class="badge bg-success fs-6 px-3 py-2">ALLOTTED</span>
            </div>
        }
        else if (Model.Status == "Partially Allotted")
        {
            <div class="alert alert-primary border-primary d-flex align-items-center justify-content-between p-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3">&#8776;</span>
                    <div>
                        <strong class="fs-6 d-block text-primary">PARTIAL ALLOTMENT CONFIRMED</strong>
                        <span class="small text-muted">Allotted @Model.AllottedShares.ToString("N0") shares out of @Model.AppliedShares.ToString("N0") shares applied. Balance funds of ₹@Model.UnblockedAmount.ToString("N2") unblocked back to your bank account.</span>
                    </div>
                </div>
                <span class="badge bg-primary fs-6 px-3 py-2">PARTIALLY ALLOTTED</span>
            </div>
        }
        else
        {
            <div class="alert alert-secondary border-secondary d-flex align-items-center justify-content-between p-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3">&#10008;</span>
                    <div>
                        <strong class="fs-6 d-block text-secondary">NOT ALLOTTED / FULL MANDATE UNBLOCKED</strong>
                        <span class="small text-muted">No shares could be allotted due to high issue oversubscription. 100% of your blocked application amount (₹@Model.UnblockedAmount.ToString("N2")) has been unblocked.</span>
                    </div>
                </div>
                <span class="badge bg-secondary fs-6 px-3 py-2">NOT ALLOTTED</span>
            </div>
        }

        <!-- 2 Column Details: Investor Details & Issue Details -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="p-3 rounded bg-light border h-100">
                    <h6 class="text-uppercase text-muted fw-bold small border-bottom pb-2 mb-3">Investor Particulars</h6>
                    <div class="row g-2 small">
                        <div class="col-5 text-muted">Investor Name:</div>
                        <div class="col-7 fw-bold">@Model.InvestorName</div>

                        <div class="col-5 text-muted">Email Address:</div>
                        <div class="col-7 text-truncate">@Model.InvestorEmail</div>

                        <div class="col-5 text-muted">Phone Number:</div>
                        <div class="col-7">@Model.InvestorPhone</div>

                        <div class="col-5 text-muted">Demat A/C (DP ID):</div>
                        <div class="col-7"><code class="text-dark">@Model.DematAccountNumber</code></div>

                        <div class="col-5 text-muted">UPI ID / VPA:</div>
                        <div class="col-7">@Model.UpiId</div>

                        <div class="col-5 text-muted">Investor Category:</div>
                        <div class="col-7"><span class="badge bg-secondary">@Model.CategoryName</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 rounded bg-light border h-100">
                    <h6 class="text-uppercase text-muted fw-bold small border-bottom pb-2 mb-3">Issue Particulars</h6>
                    <div class="row g-2 small">
                        <div class="col-5 text-muted">Security Name:</div>
                        <div class="col-7 fw-bold">@Model.IpoName</div>

                        <div class="col-5 text-muted">Issuer Company:</div>
                        <div class="col-7">@Model.CompanyName</div>

                        <div class="col-5 text-muted">Symbol / Ticker:</div>
                        <div class="col-7 fw-bold text-primary">@Model.StockSymbol</div>

                        <div class="col-5 text-muted">Application Number:</div>
                        <div class="col-7"><code class="text-dark">@Model.ApplicationNumber</code></div>

                        <div class="col-5 text-muted">Application Date:</div>
                        <div class="col-7">@Model.ApplicationDate.ToString("dd MMM yyyy, hh:mm tt")</div>

                        <div class="col-5 text-muted">Expected Listing:</div>
                        <div class="col-7">@(Model.ExpectedListingDate?.ToString("dd MMM yyyy") ?? "To be notified")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Allocation Breakdown Table -->
        <h6 class="text-uppercase text-muted fw-bold small mb-2">Bidding &amp; Allotment Accounting Statement</h6>
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Parameter</th>
                        <th class="text-center">Bidded / Applied</th>
                        <th class="text-center">Allotted / Final</th>
                        <th class="text-end">Amount Accounting</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Market Lots</strong></td>
                        <td class="text-center">@Model.AppliedLots lot(s)</td>
                        <td class="text-center fw-bold @(Model.AllottedLots > 0 ? "text-success" : "text-muted")">
                            @Model.AllottedLots lot(s)
                        </td>
                        <td class="text-end text-muted">Lot Size: @Model.LotSize</td>
                    </tr>
                    <tr>
                        <td><strong>Equity Shares</strong></td>
                        <td class="text-center">@Model.AppliedShares.ToString("N0") shares</td>
                        <td class="text-center fw-bold @(Model.AllottedShares > 0 ? "text-success" : "text-muted")">
                            @Model.AllottedShares.ToString("N0") shares
                        </td>
                        <td class="text-end text-muted">&mdash;</td>
                    </tr>
                    <tr>
                        <td><strong>Price per Share</strong></td>
                        <td class="text-center">₹@Model.BidPrice.ToString("N2")</td>
                        <td class="text-center fw-bold">₹@Model.AllotmentPrice.ToString("N2")</td>
                        <td class="text-end text-muted">Issue Cut-off</td>
                    </tr>
                    <tr>
                        <td><strong>Amount Blocked (ASBA)</strong></td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-end fw-bold">₹@Model.BlockedAmount.ToString("N2")</td>
                    </tr>
                    <tr class="table-success">
                        <td><strong>Total Amount Debited</strong></td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-end fw-bold text-success fs-6">₹@Model.DebitedAmount.ToString("N2")</td>
                    </tr>
                    <tr class="@(Model.UnblockedAmount > 0 ? "table-warning" : "")">
                        <td><strong>Total Amount Unblocked / Refunded</strong></td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-center text-muted">&mdash;</td>
                        <td class="text-end fw-bold text-dark fs-6">₹@Model.UnblockedAmount.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.AmountInWords))
        {
            <div class="mb-4 p-2 px-3 bg-light rounded small border">
                <span class="text-muted">Amount in words:</span>
                <strong>@Model.AmountInWords</strong>
            </div>
        }

        <!-- Mandate Unblock / Refund Settlement Details -->
        @if (Model.UnblockedAmount > 0)
        {
            <div class="card border-warning mb-4" style="background: #fffdf5;">
                <div class="card-body p-3">
                    <h6 class="text-dark fw-bold mb-2">&#128179; Mandate Refund / Unblock Advice</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-3 text-muted">Refund Status:</div>
                        <div class="col-sm-3 fw-bold text-success">@Model.RefundStatus</div>

                        <div class="col-sm-3 text-muted">Amount Unblocked:</div>
                        <div class="col-sm-3 fw-bold text-warning">₹@Model.UnblockedAmount.ToString("N2")</div>

                        <div class="col-sm-3 text-muted">Bank UPI Reference:</div>
                        <div class="col-sm-3 font-monospace text-primary">@(Model.RefundReferenceId ?? "N/A")</div>

                        <div class="col-sm-3 text-muted">Processed Date:</div>
                        <div class="col-sm-3">@(Model.RefundProcessedAt?.ToString("dd MMM yyyy") ?? Model.AllotmentDate.ToString("dd MMM yyyy"))</div>
                    </div>
                </div>
            </div>
        }

        <!-- Footnotes & Regulatory Declarations -->
        <div class="border-top pt-3 text-muted" style="font-size: 0.75rem; line-height: 1.5;">
            <p class="mb-1"><strong>Important Notes:</strong></p>
            <ol class="ps-3 mb-2">
                <li>This document is an electronic Confirmation of Allocation Note (CAN) issued in accordance with SEBI (Issue of Capital and Disclosure Requirements) Regulations.</li>
                <li>Allotted equity shares will be credited to your CDSL/NSDL Demat Account under ISIN prior to the official listing date on NSE/BSE.</li>
                <li>In case of partial or non-allotment, the unblocked funds have been released by your sponsor bank back to your account through the UPI ASBA mandate mechanism.</li>
                <li>For any allotment queries, contact the Registrar to the Issue: <strong>@Model.RegistrarName</strong>.</li>
            </ol>
            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                <span>Verification Hash: <code class="text-muted">@Model.VerificationCode</code></span>
                <span>Generated by IPO Investment Management System</span>
            </div>
        </div>
    </div>
</div>
