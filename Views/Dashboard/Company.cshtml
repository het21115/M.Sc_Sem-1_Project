@model IPOInvestmentManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Company Dashboard";
}

<div class="dashboard-shell py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-semibold small mb-1">Company workspace</p><h1 class="h2 mb-1">Welcome, @Model.UserName</h1><p class="text-muted mb-0">Manage your company profile and IPO pipeline.</p></div><a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Logout">Sign out</a></div>
    <div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card dashboard-stat h-100"><div class="card-body"><span>Company profiles</span><strong>@Model.CompanyCount</strong><small>Profiles linked to your account</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="card dashboard-stat h-100"><div class="card-body"><span>IPO offerings</span><strong>@Model.IpoCount</strong><small>Your submitted offerings</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="card dashboard-stat h-100"><div class="card-body"><span>Company reviews</span><strong>@Model.PendingCompanyCount</strong><small>Profiles awaiting approval</small></div></div></div><div class="col-sm-6 col-xl-3"><div class="card dashboard-stat h-100"><div class="card-body"><span>IPO reviews</span><strong>@Model.PendingIpoCount</strong><small>Offerings awaiting approval</small></div></div></div></div>
    <div class="row g-4"><div class="col-lg-5"><div class="card dashboard-card h-100"><div class="card-body p-4"><h2 class="h5 mb-3">Your company profiles</h2>@if (Model.Companies.Count == 0) { <p class="text-muted mb-0">No company profile is linked to this account yet.</p> } else { foreach (var company in Model.Companies) { <div class="company-row"><div><strong>@company.Company_name</strong><small>@(company.Industry ?? "Industry not specified")</small></div><span class="badge text-bg-light">@(company.Approval_status ?? "Pending")</span></div> } }</div></div></div><div class="col-lg-7"><div class="card dashboard-card h-100"><div class="card-body p-4"><h2 class="h5 mb-3">IPO pipeline</h2>@if (Model.CompanyIpos.Count == 0) { <p class="text-muted mb-0">Your IPO pipeline will appear here once an offering is created.</p> } else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Offering</th><th>Open date</th><th>Close date</th><th>Status</th></tr></thead><tbody>@foreach (var ipo in Model.CompanyIpos) { <tr><td class="fw-semibold">@ipo.IPO_name</td><td>@ipo.Open_date.ToString("dd MMM yyyy")</td><td>@ipo.Close_date.ToString("dd MMM yyyy")</td><td><span class="badge text-bg-light">@(ipo.Status ?? "Draft")</span></td></tr> }</tbody></table></div> }</div></div></div></div>
</div>