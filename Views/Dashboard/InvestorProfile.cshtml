@model IPOInvestmentManagement.Models.InvestorProfileViewModel
@{
    ViewData["Title"] = "Investor Profile";
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Dashboard")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>INVEST</strong></div><span class="admin-mode">INVESTOR PROFILE</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Investor")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">INVESTOR PROFILE</span><h1>Account details</h1><p>Add or update your demat account number and UPI ID whenever you are ready.</p></div></div>
        @if (TempData["InvestorMessage"] is string message) { <div class="alert alert-success" role="alert">@message</div> }
        <section class="admin-profile-card">
            <form asp-controller="Dashboard" asp-action="InvestorProfile" method="post">
                <input asp-for="UserId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="admin-profile-grid">
                    <label>First name<input asp-for="FirstName" /><span asp-validation-for="FirstName" class="text-danger"></span></label>
                    <label>Last name<input asp-for="LastName" /><span asp-validation-for="LastName" class="text-danger"></span></label>
                    <label>Email<input asp-for="Email" type="email" /><span asp-validation-for="Email" class="text-danger"></span></label>
                    <label>Phone<input asp-for="Phone" /><span asp-validation-for="Phone" class="text-danger"></span></label>
                    <label>Demat account number<input asp-for="DematAccountNumber" placeholder="Enter when available" /><span asp-validation-for="DematAccountNumber" class="text-danger"></span></label>
                    <label>UPI ID<input asp-for="UpiId" placeholder="example@upi" /><span asp-validation-for="UpiId" class="text-danger"></span></label>
                </div>
                <button class="btn btn-primary" type="submit">Save changes</button>
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
