@model IPOInvestmentManagement.Models.DashboardViewModel

@foreach (var detail in Model.PublishedIpoDetails.Where(d => 
    !string.Equals(d.Ipo.Status, "Rejected", StringComparison.OrdinalIgnoreCase) &&
    !string.Equals(d.Ipo.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
    !string.Equals(d.Ipo.Status, "Listed", StringComparison.OrdinalIgnoreCase)))
{
    var currentStatus = Model.MarketStatuses.GetValueOrDefault(detail.Ipo.IPO_id, "Upcoming");
    bool isOpen = currentStatus == "Open";
    decimal minimumLotAmount = (detail.Ipo.Lot_size ?? 0) * (detail.Ipo.Price_min ?? 0m);

    <template class="investor-apply-template" 
              data-ipo-id="@detail.Ipo.IPO_id" 
              data-status="@currentStatus"
              data-opening-dt="@detail.Ipo.OpeningDateTime.ToString("yyyy-MM-ddTHH:mm:ss")"
              data-closing-dt="@detail.Ipo.ClosingDateTime.ToString("yyyy-MM-ddTHH:mm:ss")">
        
        <div class="investor-ipo-application-wrapper" data-ipo-app-container="@detail.Ipo.IPO_id">
            <div class="investor-apply-pending-banner alert alert-info mb-3" style="@(currentStatus == "Upcoming" ? "" : "display:none;")">
                <span class="fs-5 me-2">&#9200;</span>
                <strong>Upcoming Offering:</strong> Applications open on <strong>@detail.Ipo.OpeningDateTime.ToString("dd MMM yyyy, hh:mm tt") IST</strong>. Bidding will unlock automatically at opening time.
            </div>

            <div class="investor-apply-closed-banner alert alert-secondary mb-3" style="@(currentStatus == "Closed" ? "" : "display:none;")">
                <span class="fs-5 me-2">&#128274;</span>
                <strong>Offering Closed:</strong> Bidding concluded on <strong>@detail.Ipo.ClosingDateTime.ToString("dd MMM yyyy, hh:mm tt") IST</strong>. Applications are no longer accepted for this IPO.
            </div>

            <form class="investor-apply-row investor-bid-form" 
                  asp-controller="Dashboard" 
                  asp-action="ApplyIpo" 
                  method="post" 
                  data-lot-size="@detail.Ipo.Lot_size" 
                  data-price-min="@detail.Ipo.Price_min" 
                  data-price-max="@detail.Ipo.Price_max"
                  style="@(isOpen ? "" : "display:none;")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IpoId" value="@detail.Ipo.IPO_id" />
                <div class="investor-bid-heading">
                    <strong>@detail.Ipo.IPO_name</strong>
                    <small>Investor: @Context.Session.GetString("UserName") &middot; Bid range ₹@(detail.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(detail.Ipo.Price_max?.ToString("N2") ?? "-") &middot; Closes @detail.Ipo.ClosingDateTime.ToString("dd MMM yyyy, hh:mm tt") IST &middot; Allotment @(detail.Ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "Not announced") &middot; Funds release @(detail.Ipo.Funds_unblock_date?.ToString("dd MMM yyyy") ?? "Not announced")</small>
                </div>
                <div class="investor-bid-controls">
                    <label>Investor name<input type="text" value="@(Context.Session.GetString("UserName") ?? "Investor")" readonly /></label>
                    <label>IPO name<input type="text" value="@detail.Ipo.IPO_name" readonly /></label>
                    <label>Bid price<input class="investor-bid-price" type="number" name="BidPrice" min="@detail.Ipo.Price_min" max="@detail.Ipo.Price_max" step="0.01" value="@detail.Ipo.Price_min" required /></label>
                    <label>Lot size<input type="number" value="@detail.Ipo.Lot_size" readonly /></label>
                    <label>Number of lots
                        <div class="investor-stepper">
                            <button type="button" data-lot-adjust="-1" aria-label="Decrease lots">−</button>
                            <input type="number" name="AppliedLots" min="1" value="1" required />
                            <button type="button" data-lot-adjust="1" aria-label="Increase lots">+</button>
                        </div>
                    </label>
                </div>
                <div class="investor-bid-summary">
                    <span>Total shares <strong data-bid-shares>@detail.Ipo.Lot_size</strong></span>
                    <span>Total amount <strong data-bid-total>₹@minimumLotAmount.ToString("N2")</strong></span>
                </div>
                <label class="investor-terms">
                    <input type="checkbox" name="AcceptTerms" value="true" required /> I accept the <strong>Terms &amp; Conditions</strong> and <strong>Privacy Policy</strong>
                </label>
                <button type="submit" class="btn investor-apply-button">Submit Application</button>
            </form>
        </div>
    </template>
}
