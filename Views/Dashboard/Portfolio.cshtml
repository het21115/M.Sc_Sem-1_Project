@model IPOInvestmentManagement.Models.PortfolioViewModel
@{
    ViewData["Title"] = "My Portfolio";
    decimal maximumAllocation = Model.Allocation.Count == 0 ? 1m : Model.Allocation.Max(item => item.Percentage);
}

<div class="investor-terminal portfolio-page">
    <header class="terminal-bar"><a class="terminal-logo" asp-controller="Dashboard" asp-action="Index"><span></span> IPO / <strong>INVEST</strong></a><nav aria-label="Investor navigation"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="active" href="#portfolio-top">Portfolio</a><a asp-controller="Dashboard" asp-action="Index" asp-route-marketStatus="Listed">Market</a></nav><div class="terminal-user"><span>Investor</span><i></i><a class="investor-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="terminal-main" id="portfolio-top">
        <div class="terminal-heading"><div><span class="terminal-overline">PERSONAL MARKET TERMINAL / 02</span><h1>My portfolio</h1><p class="portfolio-intro">Track holdings, transactions, allocation, and performance in one place.</p></div><div class="portfolio-actions"><a class="btn portfolio-export" asp-controller="Dashboard" asp-action="ExportPortfolio">Export Excel CSV</a><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a></div></div>
        @if (TempData["InvestorMessage"] is string investorMessage) { <div class="alert alert-info investor-dashboard-alert" role="alert">@investorMessage</div> }
        <section class="portfolio-summary" aria-label="Portfolio summary"><div><span>INVESTED AMOUNT</span><strong>₹@Model.InvestedAmount.ToString("N2")</strong></div><div><span>CURRENT VALUE</span><strong>₹@Model.CurrentValue.ToString("N2")</strong></div><div><span>UNREALIZED P/L</span><strong class="@(Model.UnrealizedProfitLoss >= 0 ? "profit" : "loss")">@(Model.UnrealizedProfitLoss >= 0 ? "+" : "-")₹@Math.Abs(Model.UnrealizedProfitLoss).ToString("N2")</strong></div><div><span>REALIZED P/L</span><strong class="@(Model.RealizedProfitLoss >= 0 ? "profit" : "loss")">@(Model.RealizedProfitLoss >= 0 ? "+" : "-")₹@Math.Abs(Model.RealizedProfitLoss).ToString("N2")</strong></div></section>
        <div class="portfolio-grid">
            <section class="portfolio-card portfolio-holdings"><div class="terminal-section-head"><div><span class="terminal-overline">01 / HOLDINGS</span><h2>Current positions</h2></div><span class="investor-library-note">@Model.Holdings.Count positions</span></div>@if (Model.Holdings.Count == 0) { <div class="terminal-empty">No active holdings yet. Use the trade panel to record a buy.</div> } else { <div class="portfolio-table"><div class="portfolio-table-head"><span>IPO / COMPANY</span><span>QTY</span><span>AVG BUY</span><span>CURRENT</span><span>VALUE</span><span>P/L</span><span></span></div>@foreach (var holding in Model.Holdings) { <div class="portfolio-table-row"><div><strong>@holding.IpoName</strong><small>@holding.CompanyName</small></div><span>@holding.Quantity.ToString("N0")</span><span>₹@holding.AverageBuyPrice.ToString("N2")</span><span>₹@holding.CurrentPrice.ToString("N2")</span><span>₹@holding.CurrentValue.ToString("N2")</span><em class="@(holding.UnrealizedProfitLoss >= 0 ? "profit" : "loss")">@(holding.UnrealizedProfitLoss >= 0 ? "+" : "-")₹@Math.Abs(holding.UnrealizedProfitLoss).ToString("N2")</em><form asp-controller="Dashboard" asp-action="Sell" method="post">@Html.AntiForgeryToken()<input type="hidden" name="InvestmentId" value="@holding.InvestmentId" /><input class="portfolio-quantity-input" type="number" name="Quantity" min="1" max="@holding.Quantity" value="1" /><input type="hidden" name="Price" value="@holding.CurrentPrice" /><button class="portfolio-sell-button" type="submit">Sell</button></form></div> }</div> }</section>
            <section class="portfolio-card portfolio-chart"><div class="terminal-section-head"><div><span class="terminal-overline">02 / ALLOCATION</span><h2>By company</h2></div></div>@if (Model.Allocation.Count == 0) { <div class="terminal-empty">Allocation appears after your first purchase.</div> } else { <div class="allocation-bars">@foreach (var item in Model.Allocation) { <div class="allocation-row"><div><strong>@item.Label</strong><span>@item.Percentage.ToString("N1")%</span></div><div class="allocation-track"><i style="width:@((item.Percentage / maximumAllocation * 100m).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small>₹@item.Value.ToString("N2")</small></div> }</div> }</section>
        </div>
        <div class="portfolio-grid portfolio-lower-grid">
            <section class="portfolio-card"><div class="terminal-section-head"><div><span class="terminal-overline">03 / TRADE ENTRY</span><h2>Record a buy</h2></div></div><form class="portfolio-trade-form" asp-controller="Dashboard" asp-action="Buy" method="post">@Html.AntiForgeryToken()<label>IPO<select name="IpoId" required><option value="">Select IPO</option>@foreach (var ipo in ViewBag.MarketIpos as List<IPO> ?? new()) { <option value="@ipo.IPO_id">@ipo.IPO_name</option> }</select></label><label>Quantity<input type="number" name="Quantity" min="1" required /></label><label>Buy price<input type="number" name="Price" min="0.01" step="0.01" required /></label><button class="btn portfolio-buy-button" type="submit">Record buy</button></form><small class="portfolio-note">Use this for simulated or manually confirmed transactions.</small></section>
            <section class="portfolio-card"><div class="terminal-section-head"><div><span class="terminal-overline">04 / ACTIVITY</span><h2>Transaction history</h2></div><span class="investor-library-note">@Model.Transactions.Count records</span></div>@if (Model.Transactions.Count == 0) { <div class="terminal-empty">No transactions recorded yet.</div> } else { <div class="transaction-list">@foreach (var transaction in Model.Transactions) { <div><span class="transaction-badge @transaction.TransactionType.ToLowerInvariant()">@transaction.TransactionType</span><strong>@transaction.IpoName</strong><small>@transaction.Quantity.ToString("N0") shares at ₹@transaction.Price.ToString("N2") &middot; @transaction.TransactionDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small><b>₹@transaction.TotalAmount.ToString("N2")</b></div> }</div> }</section>
        </div>
        <section class="portfolio-card portfolio-performance"><div class="terminal-section-head"><div><span class="terminal-overline">05 / PERFORMANCE</span><h2>Transaction cash-flow trend</h2></div><span class="investor-library-note">Buy and sell activity</span></div>@if (Model.Performance.Count == 0) { <div class="terminal-empty">Performance appears after your first transaction.</div> } else { decimal chartMaximum = Math.Max(1m, Model.Performance.Max(point => Math.Abs(point.Value))); <div class="performance-chart">@foreach (var point in Model.Performance) { <div class="performance-column"><span style="height:@((Math.Abs(point.Value) / chartMaximum * 100m).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))%;"></span><small>@point.Label</small></div> }</div> }</section>
    </main>
</div>
