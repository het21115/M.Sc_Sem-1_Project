@model IPOInvestmentManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-console">
    <header class="admin-topbar"><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@Model.UserName</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-page-actions"><a class="btn btn-primary" asp-controller="Dashboard" asp-action="Search">Search system</a><a class="btn btn-primary" asp-controller="Dashboard" asp-action="CreateNotification">Create notification</a><a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="EditProfile">Edit profile</a></div>
        <div class="admin-heading"><div><span class="admin-overline">OPERATIONS CENTER / 01</span><h1>Platform control</h1><p>Monitor the IPO marketplace and clear the work that needs attention.</p></div><div class="admin-status"><i></i> All systems operational</div></div>
        <section class="admin-kpis" aria-label="Platform summary"><div class="admin-kpi-primary"><span>Total Investors</span><strong>@Model.UserCount</strong><small>Active investor accounts</small></div><div><span>Total Companies</span><strong>@Model.CompanyCount</strong><small>Company profiles</small></div><div><span>Total IPOs</span><strong>@Model.IpoCount</strong><small>Across all companies</small></div><div><span>Pending Approvals</span><strong>@(Model.PendingCompanyCount + Model.PendingIpoCount + Model.PendingApplicationCount)</strong><small>Items requiring action</small></div><div><span>Active IPOs</span><strong>@Model.ActiveIpoCount</strong><small>Currently accepting activity</small></div><div><span>Listed IPOs</span><strong>@Model.ListedIpoCount</strong><small>Available on the market</small></div></section>
        @if (TempData["AdminMessage"] is string adminMessage)
        {
            <div class="alert alert-info mt-3" role="alert">@adminMessage</div>
        }
        <section class="admin-work-grid"><div class="admin-queue"><div class="admin-section-head"><div><span class="admin-overline">02 / WORK QUEUE</span><h2>Approvals requiring attention</h2></div><span class="queue-count">@(Model.PendingCompanyCount + Model.PendingIpoCount + Model.PendingApplicationCount) OPEN</span></div><div class="queue-items"><div><span class="queue-code company-code">CO</span><div><strong>Company profiles</strong><small>Review new company registrations</small></div><b>@Model.PendingCompanyCount</b><a class="admin-review-link" href="/Dashboard/Index#company-requests" data-review-target="company-requests">Review &#8594;</a></div><div><span class="queue-code ipo-code">IP</span><div><strong>IPO offerings</strong><small>Validate offerings before publication</small></div><b>@Model.PendingIpoCount</b><a class="admin-review-link" href="/Dashboard/Index#ipo-requests" data-review-target="ipo-requests">Review &#8594;</a></div><div><span class="queue-code app-code">AP</span><div><strong>Investor applications</strong><small>Monitor pending application activity</small></div><b>@Model.PendingApplicationCount</b><a class="admin-review-link" asp-controller="Dashboard" asp-action="Applications">Review &#8594;</a></div></div></div><aside class="admin-briefing"><span class="admin-overline">03 / ADMIN BRIEFING</span><h2>Keep the<br /><em>market trusted.</em></h2><p>Accurate company information and timely reviews help every investor make a better decision.</p><div class="admin-briefing-line"><span>ROLE</span><strong>Administrator</strong></div><div class="admin-briefing-line"><span>SESSION</span><strong>Active now</strong></div></aside></section>
        <section class="company-requests" id="company-requests"><div class="admin-section-head"><div><span class="admin-overline">03 / COMPANY REQUESTS</span><h2>Pending Companies</h2></div><span class="admin-muted">Approval required</span></div>@if (Model.PendingCompanies.Count == 0) { <div class="admin-empty">There are no pending Company registrations.</div> } else { foreach (var company in Model.PendingCompanies) { <div class="company-request-row"><div><strong>Company: @company.Company_name</strong><small>CIN: @(company.CIN ?? "Not provided")<br />Email: @(company.Email ?? "Not provided")<br />Status: @(company.Approval_status ?? "Pending")</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="CompanyDetails" asp-route-companyId="@company.Company_id">View</a><form asp-controller="Dashboard" asp-action="ApproveCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this Company registration request?');">Reject</button></form></div></div> } }</section>
        <section class="company-requests ipo-requests" id="ipo-requests"><div class="admin-section-head"><div><span class="admin-overline">04 / IPO REQUESTS</span><h2>Pending IPO submissions</h2></div><span class="admin-muted">Approval required before publication</span></div>@if (Model.PendingIpos.Count == 0) { <div class="admin-empty">There are no pending IPO submissions.</div> } else { foreach (var ipo in Model.PendingIpos) { <div class="company-request-row"><div><strong>@ipo.IPO_name</strong><small>@(Model.PendingIpoCompanyNames.GetValueOrDefault(ipo.Company_id, "Company")) &middot; Submitted @ipo.Created_at.ToString("dd MMM yyyy") &middot; ₹@((ipo.Issue_size ?? 0).ToString("N2"))</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@ipo.IPO_id">View IPO</a><form asp-controller="Dashboard" asp-action="ApproveIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this IPO submission?');">Reject</button></form></div></div> } }</section>
        <section class="company-requests application-requests" id="application-requests"><div class="admin-section-head"><div><span class="admin-overline">05 / INVESTOR APPLICATIONS</span><h2>Pending Investor applications</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Applications">View all applications &#8594;</a></div>@if (Model.PendingApplications.Count == 0) { <div class="admin-empty">There are no pending Investor applications.</div> } else { foreach (var application in Model.PendingApplications) { <div class="company-request-row"><div><strong>@Model.PendingApplicationUserNames.GetValueOrDefault(application.User_id, "Investor")</strong><small>@Model.PendingApplicationIpoNames.GetValueOrDefault(application.IPO_id, "IPO") &middot; @application.Applied_lots lot(s) / @application.Applied_shares share(s) &middot; Submitted @application.Application_date.ToString("dd MMM yyyy")</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ApplicationDetails" asp-route-applicationId="@application.Application_id">View details</a><form asp-controller="Dashboard" asp-action="ApproveApplication" method="post"><input type="hidden" name="applicationId" value="@application.Application_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyApplication" method="post"><input type="hidden" name="applicationId" value="@application.Application_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deny this investor application?');">Deny / Cancel</button></form></div></div> } }</section>
        <section class="admin-users"><div class="admin-section-head"><div><span class="admin-overline">04 / PEOPLE</span><h2>Registered users</h2></div><span class="admin-muted">Investors and companies</span></div><div class="admin-user-groups"><div class="admin-user-group"><div class="admin-user-group-head"><h3>Investors</h3><span>@Model.RecentInvestors.Count registered</span></div>@if (Model.RecentInvestors.Count == 0) { <div class="admin-empty">No investors have registered yet.</div> } else { <div class="admin-user-table"><div class="admin-user-head"><span>USER</span><span>EMAIL</span><span>ROLE</span><span>STATUS</span><span>ACTION</span></div>@foreach (var user in Model.RecentInvestors) { <div class="admin-user-row"><div class="admin-person"><span>@user.First_name.FirstOrDefault()</span><strong>@user.First_name @user.Last_name</strong></div><span>@user.Email</span><b>Investor</b><em class="active-user">@(user.Is_active ? "Active" : "Inactive")</em><a class="admin-user-details" asp-controller="Dashboard" asp-action="UserDetails" asp-route-userId="@user.User_id">View details</a></div> }</div> }</div><div class="admin-user-group"><div class="admin-user-group-head"><h3>Companies</h3><span>@Model.RecentCompanies.Count registered</span></div>@if (Model.RecentCompanies.Count == 0) { <div class="admin-empty">No companies have registered yet.</div> } else { <div class="admin-user-table"><div class="admin-user-head"><span>USER</span><span>EMAIL</span><span>ROLE</span><span>STATUS</span><span>ACTION</span></div>@foreach (var user in Model.RecentCompanies) { <div class="admin-user-row"><div class="admin-person"><span>@user.First_name.FirstOrDefault()</span><strong>@user.First_name @user.Last_name</strong></div><span>@user.Email</span><b>Company</b><em class="active-user">@(user.Is_active ? "Active" : "Inactive")</em><a class="admin-user-details" asp-controller="Dashboard" asp-action="UserDetails" asp-route-userId="@user.User_id">View details</a></div> }</div> }</div></div></section>
        <footer class="admin-footer"><span>IPO INVESTMENT MANAGEMENT / CONTROL CENTER</span><span>ACCESS IS ROLE-BASED</span></footer>
    </main>
</div>
