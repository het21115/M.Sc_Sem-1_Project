@model IPOInvestmentManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Home")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@Model.UserName</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-page-actions">
            <a class="btn btn-primary" href="#available-ipos">Available IPOs</a>
            <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="SearchIpos">Search IPOs</a>
            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#live-market-modal"><span class="ticker-pulse d-inline-block me-1" style="width:7px;height:7px;vertical-align:middle;"></span>Live Market</button>
            <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="CreateNotification">Create notification</a>
            <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="EditProfile">Edit profile</a>
        </div>
        <div class="admin-heading"><div><span class="admin-overline">OPERATIONS CENTER / 01</span><h1>Platform control</h1><p>Monitor the IPO marketplace and clear the work that needs attention.</p></div><div class="admin-status"><i></i> All systems operational</div></div>
        <section class="admin-kpis" aria-label="Platform summary">
            <div class="admin-kpi-primary"><span>Total Investors</span><strong>@Model.UserCount</strong><small>Active investor accounts</small></div>
            <div><span>Total Companies</span><strong>@Model.CompanyCount</strong><small>Company profiles</small></div>
            <div><span>Total IPOs</span><strong>@Model.IpoCount</strong><small>Across all companies</small></div>
            <div><span>Open IPOs</span><strong style="color: #10b981;">@Model.OpenIpoCount</strong><small>Currently accepting bids</small></div>
            <div><span>Upcoming IPOs</span><strong style="color: #0284c7;">@Model.UpcomingIpoCount</strong><small>Scheduled for launch</small></div>
            <div><span>Listed IPOs</span><strong style="color: #6366f1;">@Model.ListedIpoCount</strong><small>Available on the market</small></div>
        </section>
        <section class="investor-live-market-card" aria-label="Real-time live market pulse">
            <div class="live-market-copy">
                <span class="terminal-overline">
                    @if (Model.Market.IsMarketOpen)
                    {
                        <i class="ticker-pulse"></i><span>REAL-TIME NSE · BSE MARKET (LIVE SESSION)</span>
                    }
                    else
                    {
                        <i class="ticker-pulse" style="background:#ef4444; box-shadow:0 0 8px rgba(239, 68, 68, 0.4);"></i><span>REAL-TIME NSE · BSE MARKET (CLOSED)</span>
                    }
                </span>
                <strong>Live Market Pulse &amp; Dual-Exchange Feed</strong>
                <small>Real-time dual-exchange monitoring, listed stock performance, and live market quotes (09:30 AM &ndash; 03:30 PM IST).</small>
            </div>
            <div class="live-market-highlights" aria-label="Live market summary">
                <span class="live-market-stat-offers"><b>@Model.Market.Listings.Count</b><small>Listed stocks</small></span>
                <span class="live-market-stat-listed"><b>@Model.Market.TopGainers.Count</b><small>Top gainers</small></span>
                <span class="live-market-stat-open">
                    @if (Model.Market.IsMarketOpen)
                    {
                        <b class="live-market-positive"><i></i> Open</b>
                    }
                    else
                    {
                        <b class="live-market-negative"><i style="background:#ef4444;"></i> Closed</b>
                    }
                    <small>Market status (09:30 - 15:30 IST)</small>
                </span>
            </div>
            <button type="button" class="btn investor-live-market-button" data-bs-toggle="modal" data-bs-target="#live-market-modal">
                <span class="ticker-pulse d-inline-block me-1" style="width:7px;height:7px;vertical-align:middle;"></span>Live Market <span aria-hidden="true">&#8594;</span>
            </button>
        </section>
        @if (TempData["AdminMessage"] is string adminMessage)
        {
            <div class="alert alert-info mt-3" role="alert">@adminMessage</div>
        }
        @if (Model.PendingCompanies.Count > 0)
        {
            <div class="admin-company-alert" role="status">
                <div><span class="admin-company-alert-icon">!</span><div><strong>New company registration request@(Model.PendingCompanies.Count == 1 ? "" : "s")</strong><small>@Model.PendingCompanies.Count company profile@(Model.PendingCompanies.Count == 1 ? "" : "s") require@(Model.PendingCompanies.Count == 1 ? "s" : "") your review.</small></div></div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#company-registration-requests">Review requests <span aria-hidden="true">&#8594;</span></button>
            </div>
        }
        @if (Model.PendingCompanies.Count > 0)
        {
            <div class="modal fade admin-review-modal" id="company-registration-requests" tabindex="-1" aria-labelledby="company-registration-requests-title" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div><span class="admin-overline">COMPANY REGISTRATION</span><h2 class="modal-title" id="company-registration-requests-title">Requests awaiting review</h2><p>Inspect each company profile before accepting or rejecting its registration.</p></div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            @foreach (var company in Model.PendingCompanies)
                            {
                                <div class="admin-company-request-card">
                                    <div>
                                        <strong>@company.Company_name</strong>
                                        <small>@(company.Industry ?? "Industry not provided") &middot; Submitted @company.Created_at.ToString("dd MMM yyyy, hh:mm tt")</small>
                                        <small>CIN: @(company.CIN ?? "Not provided") &middot; Email: @(company.Email ?? "Not provided")</small>
                                    </div>
                                    <div class="admin-company-request-actions">
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="CompanyDetails" asp-route-companyId="@company.Company_id">View details</a>
                                        <form asp-controller="Dashboard" asp-action="ApproveCompany" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="companyId" value="@company.Company_id" />
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>
                                        <form asp-controller="Dashboard" asp-action="DenyCompany" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="companyId" value="@company.Company_id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this Company registration request?');">Reject</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (Model.PendingCompanies.Count > 0)
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    var requestModal = document.getElementById("company-registration-requests");
                    if (requestModal && window.bootstrap) {
                        new bootstrap.Modal(requestModal).show();
                    }
                });
            </script>
        }
        <section class="admin-work-grid"><div class="admin-queue"><div class="admin-section-head"><div><span class="admin-overline">02 / WORK QUEUE</span><h2>Approvals requiring attention</h2></div><span class="queue-count">@(Model.PendingCompanyCount + Model.PendingIpoCount + Model.PendingApplicationCount) OPEN</span></div><div class="queue-items"><div><span class="queue-code company-code">CO</span><div><strong>Company profiles</strong><small>Review new company registrations</small></div><b>@Model.PendingCompanyCount</b><a class="admin-review-link" href="/Dashboard/Index#company-requests" data-review-target="company-requests">Review &#8594;</a></div><div><span class="queue-code ipo-code">IP</span><div><strong>IPO offerings</strong><small>Validate offerings before publication</small></div><b>@Model.PendingIpoCount</b><a class="admin-review-link" href="/Dashboard/Index#ipo-requests" data-review-target="ipo-requests">Review &#8594;</a></div><div><span class="queue-code app-code">AP</span><div><strong>Investor applications</strong><small>Monitor pending application activity</small></div><b>@Model.PendingApplicationCount</b><a class="admin-review-link" asp-controller="Dashboard" asp-action="Applications">Review &#8594;</a></div></div></div><aside class="admin-briefing"><span class="admin-overline">03 / ADMIN BRIEFING</span><h2>Keep the<br /><em>market trusted.</em></h2><p>Accurate company information and timely reviews help every investor make a better decision.</p><div class="admin-briefing-line"><span>ROLE</span><strong>Administrator</strong></div><div class="admin-briefing-line"><span>SESSION</span><strong>Active now</strong></div></aside></section>
        <section class="admin-subscription-panel">
            <div class="admin-section-head">
                <div><span class="admin-overline">04 / DEMAND INTELLIGENCE</span><h2>IPO subscription statistics</h2><p>Compare shares offered with investor demand and track how many times each IPO is subscribed.</p></div>
                <span class="admin-muted">Latest 10 IPOs</span>
            </div>
            @if (Model.SubscriptionStatistics.Count == 0)
            {
                <div class="admin-empty">Subscription statistics will appear once an IPO has an offered share count.</div>
            }
            else
            {
                decimal maximumShares = Math.Max(1m, (decimal)Model.SubscriptionStatistics.Max(item => Math.Max(item.OfferedShares, item.AppliedShares)));
                <div class="admin-subscription-legend"><span><i class="admin-subscription-offered"></i> Offered shares</span><span><i class="admin-subscription-applied"></i> Shares bid</span><span><i class="admin-subscription-multiple"></i> Subscription multiple</span></div>
                <div class="admin-subscription-chart" role="img" aria-label="IPO subscription statistics chart">
                    @foreach (var statistic in Model.SubscriptionStatistics)
                    {
                        decimal offeredHeight = statistic.OfferedShares / maximumShares * 100m;
                        decimal appliedHeight = statistic.AppliedShares / maximumShares * 100m;
                        <div class="admin-subscription-column">
                            <div class="admin-subscription-values"><span>@statistic.AppliedShares.ToString("N0")</span><span>@statistic.OfferedShares.ToString("N0")</span></div>
                            <div class="admin-subscription-bars"><i class="admin-subscription-bar admin-subscription-applied" style="height:@appliedHeight.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%"></i><i class="admin-subscription-bar admin-subscription-offered" style="height:@offeredHeight.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%"></i></div>
                            <strong title="@statistic.Ipo.IPO_name">@statistic.Ipo.IPO_name</strong>
                            <small>@statistic.SubscriptionMultiple.ToString("N2")x subscribed &middot; @statistic.ApplicationCount.ToString("N0") applications</small>
                        </div>
                    }
                </div>
                <div class="admin-subscription-table">
                    @foreach (var statistic in Model.SubscriptionStatistics)
                    {
                        <div><strong>@statistic.Ipo.IPO_name</strong><span>@statistic.OfferedShares.ToString("N0") offered</span><span>@statistic.AppliedShares.ToString("N0") bid</span><b>@statistic.SubscriptionMultiple.ToString("N2")x</b></div>
                    }
                </div>
            }
        </section>

        <!-- 05 / AVAILABLE IPOS & DIRECTORY SECTION -->
        <section class="admin-user-details-card available-ipos-section" id="available-ipos">
            <div class="admin-section-head d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="admin-overline" style="color: #167da8;">05 / AVAILABLE IPOS DIRECTORY</span>
                    <h2>Available IPOs (Listed, Upcoming, Open, Closed)</h2>
                    <p class="mb-0 text-muted">Inspect real-time bidding status, schedules, lot sizing, investor demand, GMP quotes, and listing performance across all market offerings.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="admin-available-count-badge" class="badge bg-primary px-3 py-2">
                        Showing @Model.AllAdminIpos.Count(i => i.EffectiveStatus is "Open" or "Upcoming" or "Closed" or "Listed") Available IPOs
                    </span>
                </div>
            </div>

            <!-- Status Tabs and Search Filter Bar -->
            <div class="p-3 my-3 bg-light rounded-3 border">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <!-- Status Filter Tabs -->
                    <div class="btn-group flex-wrap" role="group" id="admin-status-tab-group" aria-label="IPO Status Filter Tabs">
                        <button type="button" class="btn btn-sm btn-outline-primary admin-status-tab-btn active" data-tab-status="available">
                            All Available <span class="badge bg-secondary ms-1">@Model.AllAdminIpos.Count(i => i.EffectiveStatus is "Open" or "Upcoming" or "Closed" or "Listed")</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success admin-status-tab-btn" data-tab-status="Open">
                            <span class="ticker-pulse d-inline-block me-1" style="width:6px;height:6px;background:#10b981;vertical-align:middle;"></span>
                            Open <span class="badge bg-success ms-1">@Model.OpenIpoCount</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-info text-dark admin-status-tab-btn" data-tab-status="Upcoming">
                            Upcoming <span class="badge bg-info text-dark ms-1">@Model.UpcomingIpoCount</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary admin-status-tab-btn" data-tab-status="Closed">
                            Closed <span class="badge bg-secondary ms-1">@Model.ClosedIpoCount</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary admin-status-tab-btn" data-tab-status="Listed">
                            Listed <span class="badge bg-primary ms-1">@Model.ListedIpoCount</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-dark admin-status-tab-btn" data-tab-status="all">
                            All IPOs <span class="badge bg-dark ms-1">@Model.AllAdminIpos.Count</span>
                        </button>
                    </div>

                    <!-- Search and Type Filter Controls -->
                    <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0" style="min-width: 280px;">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-white">&#128269;</span>
                            <input type="text" id="admin-dash-ipo-search" class="form-control" placeholder="Search IPO, company, symbol..." autocomplete="off" />
                            <button type="button" id="admin-dash-ipo-clear" class="btn btn-outline-secondary" title="Clear search" style="display:none;">&times;</button>
                        </div>
                        <select id="admin-dash-type-filter" class="form-select form-select-sm" style="width: 130px;">
                            <option value="">All Types</option>
                            <option value="Book Built">Book Built</option>
                            <option value="Fixed Price">Fixed Price</option>
                            <option value="SME">SME</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- IPOs Responsive Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border mb-0" id="admin-dash-ipos-table">
                    <thead class="table-light">
                        <tr>
                            <th>IPO Name &amp; Company</th>
                            <th>Status</th>
                            <th>Price Band / Size</th>
                            <th>Bidding Window (IST)</th>
                            <th>Allotment &amp; Listing</th>
                            <th>Demand &amp; GMP</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="admin-dash-ipos-body">
                        @if (Model.AllAdminIpos.Count == 0)
                        {
                            <tr id="admin-dash-no-ipos-row">
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <em>No IPO offerings have been registered in the system yet.</em>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.AllAdminIpos)
                            {
                                string badgeClass = item.EffectiveStatus switch
                                {
                                    "Open" => "bg-success",
                                    "Upcoming" => "bg-info text-dark",
                                    "Closed" => "bg-secondary",
                                    "Listed" => "bg-primary",
                                    "Pending" => "bg-warning text-dark border",
                                    "Approved" => "bg-info text-dark border",
                                    "Rejected" => "bg-danger",
                                    "Cancelled" => "bg-dark",
                                    _ => "bg-light text-dark border"
                                };

                                bool isAvailable = item.EffectiveStatus is "Open" or "Upcoming" or "Closed" or "Listed";

                                <tr class="admin-dash-ipo-row"
                                    data-ipo-name="@item.Ipo.IPO_name.ToLower()"
                                    data-company-name="@item.CompanyName.ToLower()"
                                    data-symbol="@(item.Listing?.StockSymbol?.ToLower() ?? "")"
                                    data-status="@item.EffectiveStatus"
                                    data-raw-status="@(item.Ipo.Status ?? "")"
                                    data-type="@(item.Ipo.IPO_type ?? "")"
                                    data-available="@(isAvailable ? "true" : "false")"
                                    style="@(isAvailable ? "" : "display:none;")">
                                    <td>
                                        <div>
                                            <button type="button" class="btn btn-link p-0 fw-bold text-decoration-none text-navy text-start" 
                                                    data-bs-toggle="modal" data-bs-target="#admin-ipo-modal-@item.Ipo.IPO_id" 
                                                    title="Click to view complete IPO details">
                                                @item.Ipo.IPO_name
                                            </button>
                                            <div class="small text-muted mt-1">
                                                <a class="text-secondary text-decoration-none" asp-controller="Dashboard" asp-action="CompanyDetails" asp-route-companyId="@item.Ipo.Company_id">
                                                    @item.CompanyName
                                                </a>
                                                &middot; <span class="badge bg-light text-secondary border">@(item.Ipo.IPO_type ?? "Equity")</span>
                                                @if (item.Listing?.StockSymbol != null)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary ms-1">@item.Listing.StockSymbol</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Company?.Industry))
                                                {
                                                    <span class="text-muted ms-1">&middot; @item.Company.Industry</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass px-2 py-1">
                                            @if (item.EffectiveStatus == "Open")
                                            {
                                                <span class="ticker-pulse d-inline-block me-1" style="width:6px;height:6px;background:#fff;vertical-align:middle;"></span>
                                            }
                                            @item.EffectiveStatus
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <strong>₹@(item.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(item.Ipo.Price_max?.ToString("N2") ?? "-")</strong>
                                            <div class="text-muted">Lot: @(item.Ipo.Lot_size?.ToString("N0") ?? "-") shs &middot; ₹@((item.Ipo.Issue_size ?? 0).ToString("N2"))</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <span>Opens: <strong>@item.Ipo.Open_date.ToString("dd MMM yyyy") (@item.Ipo.EffectiveOpeningTime.ToString(@"hh\:mm") IST)</strong></span>
                                            <div class="text-muted">Closes: @item.Ipo.Close_date.ToString("dd MMM yyyy") (@item.Ipo.EffectiveClosingTime.ToString(@"hh\:mm") IST)</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <span>Allotment: <strong>@(item.Ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "TBA")</strong></span>
                                            <div class="text-muted">Listing: @(item.Ipo.Listing_date?.ToString("dd MMM yyyy") ?? "TBA")</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div>
                                                Bids: <strong>@item.ApplicationCount</strong>
                                                <span class="badge @(item.SubscriptionMultiple >= 1m ? "bg-success" : "bg-light text-dark border") ms-1">@item.SubscriptionMultiple.ToString("N2")x</span>
                                            </div>
                                            @if (item.CurrentGmp.HasValue)
                                            {
                                                <div class="badge bg-warning-subtle text-warning-emphasis border border-warning mt-1" style="font-size:0.7rem;" title="Unofficial Grey Market Premium">
                                                    GMP: ₹@item.CurrentGmp.Value.ToString("N2") (+@item.ExpectedGainPercentage%)
                                                </div>
                                            }
                                            else if (item.Listing != null && item.Listing.NSE_listing_price.HasValue)
                                            {
                                                <div class="small text-success fw-bold mt-1">
                                                    Listed: ₹@item.Listing.NSE_listing_price.Value.ToString("N2") (+@(item.Listing.Listing_gain_percentage?.ToString("N2") ?? "0")%)
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted" style="font-size:0.75rem;">No GMP quote</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#admin-ipo-modal-@item.Ipo.IPO_id" title="View complete details">
                                                View Details
                                            </button>
                                            <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@item.Ipo.IPO_id" title="Manage Schedule, Status & GMP">
                                                Manage
                                            </a>
                                            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Applications" asp-route-ipoId="@item.Ipo.IPO_id" title="View all applications">
                                                Bids (@item.ApplicationCount)
                                            </a>
                                            @if (item.AllotmentWindowOpen)
                                            {
                                                <a class="btn btn-outline-success" asp-controller="Dashboard" asp-action="AutomaticAllotmentPreview" asp-route-ipoId="@item.Ipo.IPO_id" title="Process Allotment">
                                                    Allot
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr id="admin-dash-empty-filter-row" style="display: none;">
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <em>No IPO offerings match your selected status tab or search query.</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- IPO DETAILS MODALS (FOR ALL IPOS) -->
        @foreach (var item in Model.AllAdminIpos)
        {
            string modalBadgeClass = item.EffectiveStatus switch
            {
                "Open" => "bg-success",
                "Upcoming" => "bg-info text-dark",
                "Closed" => "bg-secondary",
                "Listed" => "bg-primary",
                "Pending" => "bg-warning text-dark border",
                _ => "bg-light text-dark border"
            };

            <div class="modal fade admin-review-modal" id="admin-ipo-modal-@item.Ipo.IPO_id" tabindex="-1" aria-labelledby="admin-ipo-modal-title-@item.Ipo.IPO_id" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div>
                                <span class="admin-overline" style="color: #167da8;">IPO SPECIFICATION &amp; PERFORMANCE</span>
                                <h2 class="modal-title d-flex align-items-center gap-2" id="admin-ipo-modal-title-@item.Ipo.IPO_id">
                                    @item.Ipo.IPO_name
                                    <span class="badge @modalBadgeClass" style="font-size: 0.75rem;">@item.EffectiveStatus</span>
                                    @if (item.Listing?.StockSymbol != null)
                                    {
                                        <span class="badge bg-dark border text-light" style="font-size: 0.75rem;">@item.Listing.StockSymbol</span>
                                    }
                                </h2>
                                <p class="mb-0">
                                    <strong>@item.CompanyName</strong>
                                    &middot; CIN: @(item.Company?.CIN ?? "Not provided")
                                    &middot; Industry: @(item.Company?.Industry ?? "General")
                                    &middot; Type: @(item.Ipo.IPO_type ?? "Equity")
                                </p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <!-- 4-TILE SUMMARY HIGHLIGHTS -->
                            <div class="row g-2 mb-4">
                                <div class="col-md-3 col-6">
                                    <div class="admin-modal-tile">
                                        <span>Price Band</span>
                                        <strong>₹@(item.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(item.Ipo.Price_max?.ToString("N2") ?? "-")</strong>
                                        <small>Lot: @(item.Ipo.Lot_size?.ToString("N0") ?? "-") shs (Min ₹@item.MinimumInvestment.ToString("N0"))</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="admin-modal-tile">
                                        <span>Total Issue Size</span>
                                        <strong style="color: #167da8;">₹@((item.Ipo.Issue_size ?? 0).ToString("N2"))</strong>
                                        <small>Offered: @(item.Ipo.Total_shares?.ToString("N0") ?? "-") shares</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="admin-modal-tile">
                                        <span>Investor Demand</span>
                                        <strong style="color: @(item.SubscriptionMultiple >= 1m ? "#10b981" : "#f59e0b");">@item.SubscriptionMultiple.ToString("N2")x Subscribed</strong>
                                        <small>@item.ApplicationCount applications &middot; @item.AppliedShares.ToString("N0") shares</small>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="admin-modal-tile">
                                        @if (item.EffectiveStatus == "Listed" && item.Listing?.NSE_listing_price.HasValue == true)
                                        {
                                            <span>Listing Day Return</span>
                                            <strong style="color: @(item.Listing.Listing_gain_percentage >= 0 ? "#10b981" : "#ef4444");">
                                                @(item.Listing.Listing_gain_percentage >= 0 ? "+" : "")@(item.Listing.Listing_gain_percentage?.ToString("N2") ?? "0")%
                                            </strong>
                                            <small>NSE: ₹@item.Listing.NSE_listing_price.Value.ToString("N2")</small>
                                        }
                                        else
                                        {
                                            <span>Grey Market Premium (GMP)</span>
                                            @if (item.CurrentGmp.HasValue)
                                            {
                                                <strong style="color: #f59e0b;">₹@item.CurrentGmp.Value.ToString("N2") (+@item.ExpectedGainPercentage%)</strong>
                                                <small>Est. Listing: ₹@(item.EstimatedListingPrice?.ToString("N2") ?? "-")</small>
                                            }
                                            else
                                            {
                                                <strong class="text-muted">No Quote</strong>
                                                <small>GMP not yet recorded</small>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- LEFT COLUMN: SCHEDULE & TIMELINE + SUBSCRIPTION -->
                                <div class="col-lg-6">
                                    <!-- SCHEDULE & TIMELINE (IST) -->
                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                        <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                            <span>&#128197;</span> Bidding Schedule &amp; Key Timeline (IST)
                                        </h6>
                                        <div class="admin-user-detail-grid" style="grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 10px;">
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">BIDDING OPENS</span>
                                                <strong class="small text-navy">@item.Ipo.OpeningDateTime.ToString("dd MMM yyyy, hh:mm tt") IST</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">BIDDING CLOSES</span>
                                                <strong class="small text-navy">@item.Ipo.ClosingDateTime.ToString("dd MMM yyyy, hh:mm tt") IST</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">ALLOTMENT ANNOUNCEMENT</span>
                                                <strong class="small text-navy">@(item.Ipo.Allotment_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">FUNDS UNBLOCK / REFUND</span>
                                                <strong class="small text-navy">@(item.Ipo.Funds_unblock_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border" style="grid-column: span 2;">
                                                <span class="text-muted small fw-bold">SECONDARY MARKET LISTING</span>
                                                <strong class="small text-navy">@(item.Ipo.Listing_date?.ToString("dd MMM yyyy") ?? "Not announced")</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- INVESTOR DEMAND & SUBSCRIPTION -->
                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                        <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                            <span>&#128200;</span> Demand &amp; Subscription Breakdown
                                        </h6>
                                        <div class="row g-2 mb-2">
                                            <div class="col-4">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <small class="text-muted d-block">APPLICATIONS</small>
                                                    <strong class="text-navy">@item.ApplicationCount.ToString("N0")</strong>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <small class="text-muted d-block">SHARES BID</small>
                                                    <strong class="text-navy">@item.AppliedShares.ToString("N0")</strong>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <small class="text-muted d-block">MULTIPLE</small>
                                                    <strong style="color: @(item.SubscriptionMultiple >= 1m ? "#10b981" : "#f59e0b");">@item.SubscriptionMultiple.ToString("N2")x</strong>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            @{
                                                int progressPercent = (int)Math.Min(100m, item.SubscriptionMultiple * 100m);
                                            }
                                            <div class="progress-bar @(item.SubscriptionMultiple >= 1m ? "bg-success" : "bg-warning")" 
                                                 role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <div class="small text-muted mt-2 d-flex justify-content-between">
                                            <span>Status: <strong>@(item.SubscriptionMultiple >= 1m ? "Oversubscribed" : "Bidding Ongoing")</strong></span>
                                            <span>Shares Offered: <strong>@(item.Ipo.Total_shares?.ToString("N0") ?? "-")</strong></span>
                                        </div>
                                    </div>

                                    <!-- DESCRIPTION -->
                                    <div class="p-3 bg-light rounded-3 border">
                                        <h6 class="fw-bold text-navy mb-1">Issue Description &amp; Objectives</h6>
                                        <p class="small text-muted mb-0" style="white-space: pre-line; max-height: 120px; overflow-y: auto;">
                                            @(string.IsNullOrWhiteSpace(item.Ipo.Description) ? "No description provided for this IPO offering." : item.Ipo.Description)
                                        </p>
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN: CAPITAL STRUCTURE, FINANCIALS, GMP & LISTING -->
                                <div class="col-lg-6">
                                    <!-- OFFERING & CAPITAL STRUCTURE -->
                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                        <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                            <span>&#128188;</span> Capital &amp; Issue Parameters
                                        </h6>
                                        <div class="admin-user-detail-grid" style="grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 10px;">
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">ISSUE TYPE</span>
                                                <strong class="small text-navy">@(item.Ipo.IPO_type ?? "Equity")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">APPLICATION TYPE</span>
                                                <strong class="small text-navy">@(item.Ipo.Apply_type ?? "ASBA / UPI")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">LOT SIZE</span>
                                                <strong class="small text-navy">@(item.Ipo.Lot_size?.ToString("N0") ?? "-") shares</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">MIN INVESTMENT</span>
                                                <strong class="small text-navy">₹@item.MinimumInvestment.ToString("N2")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">PRICE BAND</span>
                                                <strong class="small text-navy">₹@(item.Ipo.Price_min?.ToString("N2") ?? "-") - ₹@(item.Ipo.Price_max?.ToString("N2") ?? "-")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">TOTAL SHARES</span>
                                                <strong class="small text-navy">@(item.Ipo.Total_shares?.ToString("N0") ?? "-")</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- FINANCIAL FUNDAMENTALS & VALUATION -->
                                    @if (item.Financial != null || item.Analysis != null)
                                    {
                                        <div class="p-3 bg-light rounded-3 border mb-3">
                                            <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                                <span>&#128202;</span> Financial Fundamentals &amp; Ratios
                                            </h6>
                                            <div class="admin-user-detail-grid" style="grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px;">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">REVENUE</span>
                                                    <strong class="small text-navy">₹@(item.Financial?.Revenue?.ToString("N2") ?? "-")</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">PROFIT (PAT)</span>
                                                    <strong class="small text-navy">₹@(item.Financial?.Profit?.ToString("N2") ?? "-")</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">NET WORTH</span>
                                                    <strong class="small text-navy">₹@(item.Financial?.Net_worth?.ToString("N2") ?? "-")</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">ROE</span>
                                                    <strong class="small text-navy">@(item.Analysis?.ROE?.ToString("N2") ?? "-")%</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">REV GROWTH</span>
                                                    <strong class="small text-navy">@(item.Analysis?.Revenue_growth?.ToString("N2") ?? "-")%</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small fw-bold">PAT GROWTH</span>
                                                    <strong class="small text-navy">@(item.Analysis?.Profit_growth?.ToString("N2") ?? "-")%</strong>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Analysis?.Analysis_summary))
                                            {
                                                <div class="mt-2 p-2 bg-white rounded border small text-muted">
                                                    <strong>Analyst Note:</strong> @item.Analysis.Analysis_summary
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- GREY MARKET PREMIUM (GMP) & LISTING PERFORMANCE -->
                                    <div class="p-3 bg-light rounded-3 border">
                                        <h6 class="fw-bold text-navy mb-2 d-flex align-items-center gap-2">
                                            <span>&#128178;</span> Grey Market (GMP) &amp; Exchange Listing
                                        </h6>
                                        <div class="admin-user-detail-grid" style="grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 10px;">
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">CURRENT GMP</span>
                                                <strong class="small text-warning-emphasis">@(item.CurrentGmp.HasValue ? $"₹{item.CurrentGmp.Value:N2}" : "No GMP quote")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">EST. LISTING PRICE</span>
                                                <strong class="small text-navy">@(item.EstimatedListingPrice.HasValue ? $"₹{item.EstimatedListingPrice.Value:N2}" : "-")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">EXPECTED GAIN</span>
                                                <strong class="small text-success">@(item.ExpectedGainPercentage.HasValue ? $"+{item.ExpectedGainPercentage.Value}%" : "-")</strong>
                                            </div>
                                            <div class="p-2 bg-white rounded border">
                                                <span class="text-muted small fw-bold">MARKET SENTIMENT</span>
                                                <strong class="small text-navy">@(item.LatestGmpRecord?.FireRating ?? "Neutral")</strong>
                                            </div>
                                            @if (item.Listing != null)
                                            {
                                                <div class="p-2 bg-white rounded border">
                                                    <span class="text-muted small fw-bold">NSE LISTING PRICE</span>
                                                    <strong class="small text-navy">₹@(item.Listing.NSE_listing_price?.ToString("N2") ?? "-")</strong>
                                                </div>
                                                <div class="p-2 bg-white rounded border">
                                                    <span class="text-muted small fw-bold">LISTING DAY GAIN</span>
                                                    <strong class="small text-success">+@(item.Listing.Listing_gain_percentage?.ToString("N2") ?? "-")%</strong>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light d-flex justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-sm btn-primary" asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@item.Ipo.IPO_id">
                                    &#9881; Manage Schedule, Status &amp; GMP &rarr;
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Dashboard" asp-action="Applications" asp-route-ipoId="@item.Ipo.IPO_id">
                                    &#128101; View Investor Bids (@item.ApplicationCount)
                                </a>
                                @if (item.AllotmentWindowOpen)
                                {
                                    <a class="btn btn-sm btn-outline-success" asp-controller="Dashboard" asp-action="AutomaticAllotmentPreview" asp-route-ipoId="@item.Ipo.IPO_id">
                                        &#9889; Process Allotment
                                    </a>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }


        <section class="company-requests" id="company-requests"><div class="admin-section-head"><div><span class="admin-overline">05 / COMPANY REQUESTS</span><h2>Pending Companies</h2></div><span class="admin-muted">Approval required</span></div>@if (Model.PendingCompanies.Count == 0) { <div class="admin-empty">There are no pending Company registrations.</div> } else { foreach (var company in Model.PendingCompanies) { <div class="company-request-row"><div><strong>Company: @company.Company_name</strong><small>CIN: @(company.CIN ?? "Not provided")<br />Email: @(company.Email ?? "Not provided")<br />Status: @(company.Approval_status ?? "Pending")</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="CompanyDetails" asp-route-companyId="@company.Company_id">View</a><form asp-controller="Dashboard" asp-action="ApproveCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this Company registration request?');">Reject</button></form></div></div> } }</section>
        <section class="company-requests ipo-requests" id="ipo-requests"><div class="admin-section-head"><div><span class="admin-overline">04 / IPO REQUESTS</span><h2>Pending IPO submissions</h2></div><span class="admin-muted">Approval required before publication</span></div>@if (Model.PendingIpos.Count == 0) { <div class="admin-empty">There are no pending IPO submissions.</div> } else { foreach (var ipo in Model.PendingIpos) { <div class="company-request-row"><div><strong>@ipo.IPO_name</strong><small>@(Model.PendingIpoCompanyNames.GetValueOrDefault(ipo.Company_id, "Company")) &middot; Submitted @ipo.Created_at.ToString("dd MMM yyyy") &middot; ₹@((ipo.Issue_size ?? 0).ToString("N2"))</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@ipo.IPO_id">View IPO</a><form asp-controller="Dashboard" asp-action="ApproveIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this IPO submission?');">Reject</button></form></div></div> } }</section>
        <section class="company-requests application-requests" id="application-requests"><div class="admin-section-head"><div><span class="admin-overline">05 / INVESTOR APPLICATIONS</span><h2>Submitted Investor applications</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Applications">View all applications &#8594;</a></div>@if (Model.PendingApplications.Count == 0) { <div class="admin-empty">There are no submitted Investor applications.</div> } else { foreach (var application in Model.PendingApplications) { <div class="company-request-row"><div><strong>@Model.PendingApplicationUserNames.GetValueOrDefault(application.User_id, "Investor")</strong><small>@Model.PendingApplicationIpoNames.GetValueOrDefault(application.IPO_id, "IPO") &middot; @application.Applied_lots lot(s) / @application.Applied_shares share(s) &middot; Submitted @application.Application_date.ToString("dd MMM yyyy")</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ApplicationDetails" asp-route-applicationId="@application.Application_id">View details</a></div></div> } }</section>
        <section class="admin-users"><div class="admin-section-head"><div><span class="admin-overline">04 / PEOPLE</span><h2>Registered users</h2></div><span class="admin-muted">Investors and companies</span></div><div class="admin-user-groups"><div class="admin-user-group"><div class="admin-user-group-head"><h3>Investors</h3><span>@Model.RecentInvestors.Count registered</span></div>@if (Model.RecentInvestors.Count == 0) { <div class="admin-empty">No investors have registered yet.</div> } else { <div class="admin-user-table"><div class="admin-user-head"><span>USER</span><span>EMAIL</span><span>ROLE</span><span>STATUS</span><span>ACTION</span></div>@foreach (var user in Model.RecentInvestors) { <div class="admin-user-row"><div class="admin-person"><span>@(user.First_name?.FirstOrDefault() ?? '?')</span><strong>@user.First_name @user.Last_name</strong></div><span>@user.Email</span><b>Investor</b><em class="active-user">@(user.Is_active ? "Active" : "Inactive")</em><a class="admin-user-details" asp-controller="Dashboard" asp-action="UserDetails" asp-route-userId="@user.User_id">View details</a></div> }</div> }</div><div class="admin-user-group"><div class="admin-user-group-head"><h3>Companies</h3><span>@Model.RecentCompanies.Count registered</span></div>@if (Model.RecentCompanies.Count == 0) { <div class="admin-empty">No companies have registered yet.</div> } else { <div class="admin-user-table"><div class="admin-user-head"><span>USER</span><span>EMAIL</span><span>ROLE</span><span>STATUS</span><span>ACTION</span></div>@foreach (var user in Model.RecentCompanies) { <div class="admin-user-row"><div class="admin-person"><span>@(user.First_name?.FirstOrDefault() ?? '?')</span><strong>@user.First_name @user.Last_name</strong></div><span>@user.Email</span><b>Company</b><em class="active-user">@(user.Is_active ? "Active" : "Inactive")</em><a class="admin-user-details" asp-controller="Dashboard" asp-action="UserDetails" asp-route-userId="@user.User_id">View details</a></div> }</div> }</div></div></section>
        <section class="company-requests approved-ipo-requests" id="approved-ipo-requests">
            <div class="admin-section-head"><div><span class="admin-overline">06 / PUBLICATION QUEUE</span><h2>Approved IPOs ready to publish</h2></div><span class="admin-muted">Admin publication required</span></div>
            @if (Model.ApprovedIpos.Count == 0)
            {
                <div class="admin-empty">There are no approved IPOs waiting for publication.</div>
            }
            else
            {
                foreach (var ipo in Model.ApprovedIpos)
                {
                    <div class="company-request-row"><div><strong>@ipo.IPO_name</strong><small>@Model.ApprovedIpoCompanyNames.GetValueOrDefault(ipo.Company_id, "Company") &middot; Approved @ipo.Created_at.ToString("dd MMM yyyy") &middot; Opens @ipo.Open_date.ToString("dd MMM yyyy")</small></div><div class="company-request-actions"><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="IpoDetails" asp-route-ipoId="@ipo.IPO_id">View IPO</a><form asp-controller="Dashboard" asp-action="PublishIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-success">Publish IPO</button></form></div></div>
                }
            }
        </section>
        <partial name="_InvestorLiveMarket" model="Model" />
        <footer class="admin-footer"><span>IPO INVESTMENT MANAGEMENT / CONTROL CENTER</span><span>ACCESS IS ROLE-BASED</span></footer>
    </main>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const statusTabButtons = document.querySelectorAll(".admin-status-tab-btn");
        const ipoSearchInput = document.getElementById("admin-dash-ipo-search");
        const ipoTypeSelect = document.getElementById("admin-dash-type-filter");
        const clearSearchBtn = document.getElementById("admin-dash-ipo-clear");
        const countBadge = document.getElementById("admin-available-count-badge");
        const ipoRows = document.querySelectorAll(".admin-dash-ipo-row");
        const emptyFilterRow = document.getElementById("admin-dash-empty-filter-row");

        let activeTabStatus = "available";

        function filterAvailableIpos() {
            const query = (ipoSearchInput ? ipoSearchInput.value.trim().toLowerCase() : "");
            const type = (ipoTypeSelect ? ipoTypeSelect.value.toLowerCase() : "");

            if (clearSearchBtn) {
                clearSearchBtn.style.display = query.length > 0 ? "inline-block" : "none";
            }

            let visibleCount = 0;
            ipoRows.forEach(row => {
                const ipoName = row.getAttribute("data-ipo-name") || "";
                const companyName = row.getAttribute("data-company-name") || "";
                const symbol = row.getAttribute("data-symbol") || "";
                const rowStatus = row.getAttribute("data-status") || "";
                const rowRawStatus = row.getAttribute("data-raw-status") || "";
                const rowType = row.getAttribute("data-type") || "";
                const isAvailable = row.getAttribute("data-available") === "true";

                // Tab filter matching
                let matchesTab = false;
                if (activeTabStatus === "all") {
                    matchesTab = true;
                } else if (activeTabStatus === "available") {
                    matchesTab = isAvailable;
                } else {
                    matchesTab = (rowStatus.toLowerCase() === activeTabStatus.toLowerCase() ||
                                  rowRawStatus.toLowerCase() === activeTabStatus.toLowerCase());
                }

                // Query filter matching
                const matchesQuery = !query || 
                                     ipoName.includes(query) || 
                                     companyName.includes(query) || 
                                     symbol.includes(query);

                // Type filter matching
                const matchesType = !type || rowType.toLowerCase().includes(type);

                if (matchesTab && matchesQuery && matchesType) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (countBadge) {
                const label = activeTabStatus === "all" ? "Total" : (activeTabStatus === "available" ? "Available" : activeTabStatus);
                countBadge.textContent = `Showing ${visibleCount} ${label} IPO${visibleCount === 1 ? "" : "s"}`;
            }

            if (emptyFilterRow) {
                emptyFilterRow.style.display = (visibleCount === 0 && ipoRows.length > 0) ? "" : "none";
            }
        }

        statusTabButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                statusTabButtons.forEach(b => b.classList.remove("active"));
                this.classList.add("active");
                activeTabStatus = this.getAttribute("data-tab-status") || "available";
                filterAvailableIpos();
            });
        });

        if (ipoSearchInput) {
            ipoSearchInput.addEventListener("input", filterAvailableIpos);
        }

        if (ipoTypeSelect) {
            ipoTypeSelect.addEventListener("change", filterAvailableIpos);
        }

        if (clearSearchBtn) {
            clearSearchBtn.addEventListener("click", function () {
                ipoSearchInput.value = "";
                filterAvailableIpos();
                ipoSearchInput.focus();
            });
        }

        // Check for URL query parameter or hash to automatically activate a tab
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const statusParam = urlParams.get("adminIpoStatus") || urlParams.get("status");
            if (statusParam) {
                const targetBtn = Array.from(statusTabButtons).find(btn => 
                    (btn.getAttribute("data-tab-status") || "").toLowerCase() === statusParam.toLowerCase());
                if (targetBtn) {
                    targetBtn.click();
                }
            } else {
                filterAvailableIpos();
            }
        } catch (e) {
            filterAvailableIpos();
        }
    });
</script>
