@model IPOInvestmentManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-console">
    <header class="admin-topbar"><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@Model.UserName</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">OPERATIONS CENTER / 01</span><h1>Platform control</h1><p>Monitor the IPO marketplace and clear the work that needs attention.</p></div><div class="admin-status"><i></i> All systems operational</div></div>
        <section class="admin-kpis" aria-label="Platform summary"><div class="admin-kpi-primary"><span>Total users</span><strong>@Model.UserCount</strong><small>Registered accounts</small></div><div><span>Companies</span><strong>@Model.CompanyCount</strong><small>Profiles on platform</small></div><div><span>IPO offerings</span><strong>@Model.IpoCount</strong><small>Across all companies</small></div><div><span>Review load</span><strong>@(Model.PendingCompanyCount + Model.PendingIpoCount + Model.PendingApplicationCount)</strong><small>Items requiring action</small></div></section>
        @if (TempData["AdminMessage"] is string adminMessage)
        {
            <div class="alert alert-info mt-3" role="alert">@adminMessage</div>
        }
        <section class="admin-work-grid"><div class="admin-queue"><div class="admin-section-head"><div><span class="admin-overline">02 / WORK QUEUE</span><h2>Approvals requiring attention</h2></div><span class="queue-count">@(Model.PendingCompanyCount + Model.PendingIpoCount + Model.PendingApplicationCount) OPEN</span></div><div class="queue-items"><div><span class="queue-code company-code">CO</span><div><strong>Company profiles</strong><small>Review new company registrations</small></div><b>@Model.PendingCompanyCount</b><a href="#company-requests">Review &#8594;</a></div><div><span class="queue-code ipo-code">IP</span><div><strong>IPO offerings</strong><small>Validate offerings before publication</small></div><b>@Model.PendingIpoCount</b><a href="#ipo-requests">Review &#8594;</a></div><div><span class="queue-code app-code">AP</span><div><strong>Investor applications</strong><small>Monitor pending application activity</small></div><b>@Model.PendingApplicationCount</b><a href="#">Review &#8594;</a></div></div></div><aside class="admin-briefing"><span class="admin-overline">03 / ADMIN BRIEFING</span><h2>Keep the<br /><em>market trusted.</em></h2><p>Accurate company information and timely reviews help every investor make a better decision.</p><div class="admin-briefing-line"><span>ROLE</span><strong>Administrator</strong></div><div class="admin-briefing-line"><span>SESSION</span><strong>Active now</strong></div></aside></section>
        <section class="company-requests" id="company-requests"><div class="admin-section-head"><div><span class="admin-overline">03 / COMPANY REQUESTS</span><h2>Pending Company registrations</h2></div><span class="admin-muted">Approval required</span></div>@if (Model.PendingCompanies.Count == 0) { <div class="admin-empty">There are no pending Company registrations.</div> } else { foreach (var company in Model.PendingCompanies) { <div class="company-request-row"><div><strong>@company.Company_name</strong><small>@company.Email &middot; Submitted @company.Created_at.ToString("dd MMM yyyy")</small></div><div class="company-request-actions"><form asp-controller="Dashboard" asp-action="ApproveCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-success">Approve</button></form><form asp-controller="Dashboard" asp-action="DenyCompany" method="post"><input type="hidden" name="companyId" value="@company.Company_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deny this Company registration request?');">Deny / Cancel</button></form></div></div> } }</section>
        <section class="company-requests ipo-requests" id="ipo-requests"><div class="admin-section-head"><div><span class="admin-overline">04 / IPO REQUESTS</span><h2>Pending IPO submissions</h2></div><span class="admin-muted">Approval required before publication</span></div>@if (Model.PendingIpos.Count == 0) { <div class="admin-empty">There are no pending IPO submissions.</div> } else { foreach (var ipo in Model.PendingIpos) { <div class="company-request-row"><div><strong>@ipo.IPO_name</strong><small>@(Model.PendingIpoCompanyNames.GetValueOrDefault(ipo.Company_id, "Company")) &middot; Submitted @ipo.Created_at.ToString("dd MMM yyyy") &middot; ₹@((ipo.Issue_size ?? 0).ToString("N2"))</small></div><div class="company-request-actions"><form asp-controller="Dashboard" asp-action="ApproveIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-success">Approve IPO</button></form><form asp-controller="Dashboard" asp-action="DenyIpo" method="post"><input type="hidden" name="ipoId" value="@ipo.IPO_id" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deny this IPO submission?');">Deny / Cancel</button></form></div></div> } }</section>
        <section class="admin-users"><div class="admin-section-head"><div><span class="admin-overline">04 / PEOPLE</span><h2>Recently registered users</h2></div><span class="admin-muted">Latest five accounts</span></div>@if (Model.RecentUsers.Count == 0) { <div class="admin-empty">No users have registered yet.</div> } else { <div class="admin-user-table"><div class="admin-user-head"><span>USER</span><span>EMAIL</span><span>ROLE</span><span>STATUS</span></div>@foreach (var user in Model.RecentUsers) { <div class="admin-user-row"><div class="admin-person"><span>@user.First_name.FirstOrDefault()</span><strong>@user.First_name @user.Last_name</strong></div><span>@user.Email</span><b>@(user.Role ?? "User")</b><em class="active-user">Active</em></div> }</div> }</section>
        <footer class="admin-footer"><span>IPO INVESTMENT MANAGEMENT / CONTROL CENTER</span><span>ACCESS IS ROLE-BASED</span></footer>
    </main>
</div>