@model IPOInvestmentManagement.Models.AdminApplicationsViewModel
@{
    ViewData["Title"] = "Applications";
}

<div class="admin-console">
    <header class="admin-topbar"><button type="button" class="admin-back-button" data-admin-back="@Url.Action("Index", "Dashboard")" title="Go back">&#8592; Back</button><div class="admin-brand"><span></span> IPO <strong>CONTROL</strong></div><span class="admin-mode">ADMINISTRATOR MODE / SECURE SESSION</span><div class="admin-user"><span>@(Context.Session.GetString("UserName") ?? "Admin")</span><i></i><a class="admin-signout" asp-controller="Account" asp-action="Logout">Sign out <span aria-hidden="true">&#8599;</span></a></div></header>
    <main class="admin-main">
        <div class="admin-heading"><div><span class="admin-overline">05 / APPLICATION CONTROL</span><h1>Investor applications</h1><p>Review applications, inspect investor details, and monitor demand by IPO.</p></div><div class="admin-status"><i></i> Administrator access</div></div>
        @if (TempData["AdminMessage"] is string adminMessage) { <div class="alert alert-info mt-3" role="alert">@adminMessage</div> }
        <section class="admin-application-stats">
            <div><span>Total applications</span><strong>@Model.TotalApplications.ToString("N0")</strong><small>Matching the current filters</small></div>
            <div><span>Total shares applied</span><strong>@Model.TotalSharesApplied.ToString("N0")</strong><small>Across selected applications</small></div>
            <div><span>Total amount</span><strong>₹@((Model.TotalAmount / 10000000m).ToString("N2")) Crore</strong><small>Application value</small></div>
        </section>
        <section class="admin-application-panel">
            <div class="admin-section-head"><div><span class="admin-overline">APPLICATION REGISTER</span><h2>All applications</h2></div><a class="admin-back-link" asp-controller="Dashboard" asp-action="Index" asp-fragment="application-requests">Back to dashboard</a></div>
            <div class="alert alert-info">Eligible for allotment: <strong>@Model.EligibleApplications.Count</strong> submitted application(s) with verified payment.</div>
            <div class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-3 bg-light border rounded">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">🔄</span>
                    <div>
                        <strong>Payment Reconciliation & Gateway Management</strong>
                        <div class="small text-muted">Automatically reconcile pending/failed orders, verify captured mandates, sync refunds, and retry webhooks.</div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2 mt-md-0">
                    <form asp-controller="Dashboard" asp-action="ReconcilePayments" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-primary fw-bold" type="submit" title="Reconcile pending/created payments and unblocked funds with gateway">
                            ⚡ Reconcile Payments Now
                        </button>
                    </form>
                    <form asp-controller="Dashboard" asp-action="RetryWebhooks" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Re-process failed webhooks">
                            🔄 Retry Webhooks
                        </button>
                    </form>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="AllotmentHistory">
                    &#128339; Allotment History Archive
                </a>
                @if (Model.SelectedIpoId.HasValue)
                {
                    <a class="btn btn-outline-success" asp-controller="Dashboard" asp-action="AllotmentResults" asp-route-ipoId="@Model.SelectedIpoId.Value">
                        &#128737; View Allotment Results
                    </a>
                    <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="AutomaticAllotmentPreview" asp-route-ipoId="@Model.SelectedIpoId.Value">
                        &#9881; Preview Automatic Allotment
                    </a>
                    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="AllotmentReport" asp-route-ipoId="@Model.SelectedIpoId.Value">
                        &#128196; Download Allotment CSV
                    </a>
                }
            </div>
            <form class="admin-application-filters" asp-controller="Dashboard" asp-action="Applications" method="get">
                <label>Filter by IPO<select name="ipoId"><option value="">All IPOs</option>@foreach (var ipo in Model.AvailableIpos) { <option value="@ipo.IPO_id" selected="@(Model.SelectedIpoId == ipo.IPO_id)">@ipo.IPO_name</option> }</select></label>
                <label>Filter by status<select name="status"><option value="">All statuses</option><option value="Submitted" selected="@(Model.SelectedStatus == "Submitted")">Submitted</option><option value="Allotted" selected="@(Model.SelectedStatus == "Allotted")">Allotted</option><option value="Partially Allotted" selected="@(Model.SelectedStatus == "Partially Allotted")">Partially Allotted</option><option value="Not Allotted" selected="@(Model.SelectedStatus == "Not Allotted")">Not Allotted</option><option value="Rejected" selected="@(Model.SelectedStatus == "Rejected")">Rejected</option><option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">Cancelled</option></select></label>
                <button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Applications">Clear</a>
            </form>
            @if (Model.Applications.Count == 0) { <div class="admin-empty">No applications match the selected filters.</div> } else {
                @if (Model.SelectedIpoId.HasValue)
                {
                    <form id="bulk-allotment-form" asp-controller="Dashboard" asp-action="ProcessBulkAllotment" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IpoId" value="@Model.SelectedIpoId.Value" />
                        <button class="btn btn-primary" type="submit">Process selected applications as applied</button>
                        <span class="admin-muted">Select eligible applications below. Allotment opens on or after the IPO allotment date once bidding closes, and is validated against the lot size and available shares.</span>
                    </form>
                }
                <div class="admin-application-list">
                    @foreach (var item in Model.Applications) {
                        <div class="admin-application-row"><div>@if (Model.SelectedIpoId.HasValue && item.Allotment is null && item.AllotmentWindowOpen && item.Application.Status == "Submitted" && item.Application.Payment_status == "Verified") { <input type="checkbox" name="ApplicationIds" value="@item.Application.Application_id" form="bulk-allotment-form" /> }<strong>@item.IpoName</strong><small>@item.InvestorName &middot; @item.InvestorEmail &middot; Applied @item.Application.Applied_shares.ToString("N0") shares on @item.Application.Application_date.AddHours(5.5).ToString("dd MMM yyyy")@if (item.Allotment is not null) { <text> &middot; Allotted @item.Allotment.Allotted_shares.ToString("N0") shares</text> }@if (item.Allotment is null && !item.AllotmentWindowOpen) { <text> &middot; @(string.IsNullOrWhiteSpace(item.AllotmentTimingStatus) ? $"Allotment date: {item.Ipo?.Allotment_date?.ToString("dd MMM yyyy") ?? "Not configured"}" : item.AllotmentTimingStatus)</text> }</small></div><div class="admin-application-row-meta"><span class="admin-application-status">@item.Application.Status</span><a class="btn btn-sm btn-outline-primary" asp-controller="Dashboard" asp-action="ApplicationDetails" asp-route-applicationId="@item.Application.Application_id">View details</a><a class="btn btn-sm btn-outline-success ms-1" asp-controller="Dashboard" asp-action="PaymentReceiptByApplication" asp-route-applicationId="@item.Application.Application_id" title="View official payment receipt">📄 Receipt</a>@if (item.Allotment is not null) { <a class="btn btn-sm btn-outline-info ms-1 text-dark" asp-controller="Dashboard" asp-action="AllotmentAdvice" asp-route-applicationId="@item.Application.Application_id" title="View Confirmation of Allocation Note">📄 CAN Advice</a><a class="btn btn-sm btn-outline-secondary ms-1" asp-controller="Dashboard" asp-action="DownloadAllotmentAdvicePdf" asp-route-applicationId="@item.Application.Application_id" target="_blank" title="Download PDF Allotment Advice">💾 PDF</a> }</div></div>
                    }
                </div>
            }
        </section>
    </main>
</div>
